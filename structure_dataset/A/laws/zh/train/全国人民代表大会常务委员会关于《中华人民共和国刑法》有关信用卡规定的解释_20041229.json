  "units": [
    {
      "unit_id": 0,
      "text": "全国人民代表大会常务委员会",
      "type": "title",
      "level": 0,
      "parent_id": null
    },
    {
      "unit_id": 1,
      "text": "关于《中华人民共和国刑法》有关",
      "type": "paragraph",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 2,
      "text": "信用卡规定的解释",
      "type": "paragraph",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 3,
      "text": "（2004年12月29日第十届全国人民代表大会常务委员会第十三次会议通过）",
      "type": "paragraph",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 4,
      "text": "全国人民代表大会常务委员会根据司法实践中遇到的情况，讨论了刑法规定的“信用卡”的含义问题，解释如下：刑法规定的“信用卡”，是指由商业银行或者其他金融机构发行的具有消费支付、信用贷款、转账结算、存取现金等全部功能或者部分功能的电子支付卡。",
      "type": "paragraph",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 5,
      "text": "现予公告。",
      "type": "paragraph",
      "level": 1,
      "parent_id": 0
    }
  ]
}
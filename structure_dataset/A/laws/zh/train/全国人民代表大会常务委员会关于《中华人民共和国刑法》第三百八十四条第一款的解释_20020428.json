  "units": [
    {
      "unit_id": 0,
      "text": "全国人民代表大会常务委员会关于",
      "type": "title",
      "level": 0,
      "parent_id": null
    },
    {
      "unit_id": 1,
      "text": "《中华人民共和国刑法》第三百八十四条",
      "type": "paragraph",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 2,
      "text": "第一款的解释",
      "type": "paragraph",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 3,
      "text": "（2002年4月28日第九届全国人民代表大会常务委员会第二十七次会议通过）",
      "type": "paragraph",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 4,
      "text": "全国人民代表大会常务委员会讨论了刑法第三百八十四条第一款规定的国家工作人员利用职务上的便利，挪用公款“归个人使用”的含义问题，解释如下：",
      "type": "paragraph",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 5,
      "text": "有下列情形之一的，属于挪用公款“归个人使用”：",
      "type": "paragraph",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 6,
      "text": "（一）将公款供本人、亲友或者其他自然人使用的；",
      "type": "list-item",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 7,
      "text": "（二）以个人名义将公款供其他单位使用的；",
      "type": "list-item",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 8,
      "text": "（三）个人决定以单位名义将公款供其他单位使用，谋取个人利益的。",
      "type": "list-item",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 9,
      "text": "现予公告。",
      "type": "paragraph",
      "level": 1,
      "parent_id": 0
    }
  ]
}
  "units": [
    {
      "unit_id": 0,
      "text": "全国人民代表大会常务委员会关于",
      "type": "title",
      "level": 0,
      "parent_id": null
    },
    {
      "unit_id": 1,
      "text": "《中华人民共和国刑法》第九十三条",
      "type": "paragraph",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 2,
      "text": "第二款的解释",
      "type": "paragraph",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 3,
      "text": "（2000年4月29日第九届全国人民代表大会常务委员会第十五次会议通过 根据2009年8月27日第十一届全国人民代表大会常务委员会第十次会议《关于修改部分法律的决定》修正）",
      "type": "paragraph",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 4,
      "text": "全国人民代表大会常务委员会讨论了村民委员会等村基层组织人员在从事哪些工作时属于刑法第九十三条第二款规定的“其他依照法律从事公务的人员”，解释如下：",
      "type": "paragraph",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 5,
      "text": "村民委员会等村基层组织人员协助人民政府从事下列行政管理工作，属于刑法第九十三条第二款规定的“其他依照法律从事公务的人员”：",
      "type": "paragraph",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 6,
      "text": "（一）救灾、抢险、防汛、优抚、扶贫、移民、救济款物的管理；",
      "type": "list-item",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 7,
      "text": "（二）社会捐助公益事业款物的管理；",
      "type": "list-item",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 8,
      "text": "（三）国有土地的经营和管理；",
      "type": "list-item",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 9,
      "text": "（四）土地征收、征用补偿费用的管理；",
      "type": "list-item",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 10,
      "text": "（五）代征、代缴税款；",
      "type": "list-item",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 11,
      "text": "（六）有关计划生育、户籍、征兵工作；",
      "type": "list-item",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 12,
      "text": "（七）协助人民政府从事的其他行政管理工作。",
      "type": "list-item",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 13,
      "text": "村民委员会等村基层组织人员从事前款规定的公务，利用职务上的便利，非法占有公共财物、挪用公款、索取他人财物或者非法收受他人财物，构成犯罪的，适用刑法第三百八十二条和第三百八十三条贪污罪、第三百八十四条挪用公款罪、第三百八十五条和第三百八十六条受贿罪的规定。",
      "type": "paragraph",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 14,
      "text": "现予公告。",
      "type": "paragraph",
      "level": 1,
      "parent_id": 0
    }
  ]
}
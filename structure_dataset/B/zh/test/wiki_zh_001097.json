{
  "doc_id": "doc_001",
  "doc_name": "2011年电影是2011电影大事纪。",
  "language": "zh",
  "units": [
    {
      "unit_id": 0,
      "text": "2011年电影是2011电影大事纪。",
      "type": "title",
      "level": 0,
      "parent_id": null
    },
    {
      "unit_id": 1,
      "text": "全球票房最高的电影",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 2,
      "text": "2011年全球票房最高的电影如下：",
      "type": "paragraph",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 3,
      "text": "大事纪",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 4,
      "text": "* 2011年是一个年，它的第一天从星期六开始。",
      "type": "list-item",
      "level": 2,
      "parent_id": 3
    },
    {
      "unit_id": 5,
      "text": "* 1月16日，第68届金球奖颁奖礼于加州比佛利山庄的比佛利希尔顿饭店举行。",
      "type": "list-item",
      "level": 2,
      "parent_id": 3
    },
    {
      "unit_id": 6,
      "text": "* 2月10日：第61届柏林影展开幕",
      "type": "list-item",
      "level": 2,
      "parent_id": 3
    },
    {
      "unit_id": 7,
      "text": "* 2月13日，第64届英国电影和电视艺术学院公布得奖名单。",
      "type": "list-item",
      "level": 2,
      "parent_id": 3
    },
    {
      "unit_id": 8,
      "text": "* 2月28日，第83届奥斯卡金像奖公布得奖名单及颁奖典礼。",
      "type": "list-item",
      "level": 2,
      "parent_id": 3
    },
    {
      "unit_id": 9,
      "text": "最高票房",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 10,
      "text": "重要奖项",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 11,
      "text": "金球奖（第68届）",
      "type": "heading",
      "level": 2,
      "parent_id": 10
    },
    {
      "unit_id": 12,
      "text": "* 最佳戏剧类影片：《社交网络》（The Social Network）",
      "type": "list-item",
      "level": 3,
      "parent_id": 11
    },
    {
      "unit_id": 13,
      "text": "* 最佳音乐或喜剧类影片：《非单亲关系》（The Kids Are All Right）",
      "type": "list-item",
      "level": 3,
      "parent_id": 11
    },
    {
      "unit_id": 14,
      "text": "* 最佳导演：大卫·芬查－《社交网络》（The Social Network）",
      "type": "list-item",
      "level": 3,
      "parent_id": 11
    },
    {
      "unit_id": 15,
      "text": "* 最佳剧本：艾伦·索金－《社交网络》（The Social Network）",
      "type": "list-item",
      "level": 3,
      "parent_id": 11
    },
    {

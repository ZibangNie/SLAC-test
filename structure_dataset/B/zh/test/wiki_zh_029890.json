{
  "doc_id": "doc_001",
  "doc_name": "1952年香港",
  "language": "zh",
  "units": [
    {
      "unit_id": 0,
      "text": "1952年香港",
      "type": "title",
      "level": 0,
      "parent_id": null
    },
    {
      "unit_id": 1,
      "text": "政府成员变动大事记",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 2,
      "text": "* 1月3日，新任澳督史伯泰到港访问。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 3,
      "text": "* 1月16日，参加过中共特务工作的作家陈寒波，在黄大仙竹园联合村的觉荫园木屋惨死。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 4,
      "text": "* 1月23日，港岛与长洲间的海底电话线路舖设完成。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 5,
      "text": "* 2月5日，港督葛量洪获延任2年。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 6,
      "text": "* 2月6日，英皇乔治六世因肺癌病逝，终年56岁。2月7日，全港下半旗致哀，股市停市一天。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 7,
      "text": "* 2月9日，港府在皇后像广场举行英女皇伊利沙伯二世登基公告之宣读典礼。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 8,
      "text": "* 2月11日，布尔吉被委任为香港防卫司。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 9,
      "text": "* 2月15日，已故英皇乔治六世在英国举行国葬，香港市民于正午时份全体默哀2分钟。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 10,
      "text": "* 2月17日，长洲电话服务正式启用。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 11,
      "text": "* 2月24日，总督检阅香港防卫军。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 12,
      "text": "* 3月16日，皇后大道中10号和成银行发生劫案。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 13,
      "text": "* 4月6日，青山道4车相撞，2死3伤。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 14,
      "text": "* 4月22日：\n * 大批左派人士被递解出境。\n * 上水石李村男子用刀杀害前妻。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 15,
      "text": "* 4月30日，九龙仔木屋区大火，2死10余伤，灾民近8,000名。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 16,
      "text": "* 5月19日，香港红十字会与医务局合作成立「血库」，即日起接受自愿捐血。5月24日，港督葛量洪在玛丽医院捐血。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 17,
      "text": "* 5月22日，荃湾南新染布厂学徒梦中被斩毙。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 18,
      "text": "* 5月28日，马鞍山矿场塌屋40间，3人丧生。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 19,
      "text": "* 5月30日：\n * 香港举行二战后首次市民参与的选举，在市政局非官守议员选举中，贝纳祺以1,168票及雷瑞德以1,068票当选议员，本次选举合资格投票者9,074人，3,368人到场投票，投票率约37%，显示港人对民主制度有需求。\n * 第四届香港小姐竞选举行决赛，但茱迪夺得1952年度香港小姐冠军，她在同年6月代表香港到美国加州长滩参加第一届环球小姐竞选获得第四名。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 20,
      "text": "* 6月11日－6月12日，热带风暴夏绿蒂袭港，天文台悬挂八号风球。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 21,
      "text": "* 6月25日，李郑屋村塌屋，3死5伤。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 22,
      "text": "* 7月19日，骆克道121号老翁与媳妇口角后将其狂斩12刀致死。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 23,
      "text": "* 8月20日，九龙仔东平里5号2楼，洪全以牛肉刀刺向李澄海及其妻子，妻子为救丈夫被刺十七刀，李澄海亦身中三刀，洪全掷刀逃去又服毒图死。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 24,
      "text": "* 8月26日，皇后大道西519号红梅酒店二楼209号房，金姓妇人赤裸被刺死榻上。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 25,
      "text": "* 8月28日，一辆警车赶往调查交通意外时在弥敦道兴荔枝角道交界失事一死一伤。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 26,
      "text": "* 9月22日，荃湾西楼角山洪暴发，2死12失踪。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 27,
      "text": "* 9月27日，九龙城嘉林边道发生大火，焚毁华达制片厂及30间木屋。工商晚报, 1952-09-27  第3页",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 28,
      "text": "* 10月1日，电话费加价，商用电话增50%，家用电话增12.5%。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 29,
      "text": "* 10月12日，港府宣布，今后每年4月21日定为庆祝女皇伊利沙伯二世寿辰公众假期。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 30,
      "text": "* 10月24日，日本驻港总领事馆开馆。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 31,
      "text": "* 10月26日，白英奇出任天主教香港教区第二任主教。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 32,
      "text": "* 10月22日，薄扶林道军车翻侧，2死27伤。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 33,
      "text": "* 11月28日，石硖尾村木屋区大火，15人受伤，3,735人无家可归。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 34,
      "text": "* 12月22日，香港第3艘灭火轮葛量洪号下水启用。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 35,
      "text": "出生人物",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 36,
      "text": "* 1月29日—梁锦松，香港银行业人士，香港特别行政区第2任财政司司长。",
      "type": "list-item",
      "level": 2,
      "parent_id": 35
    },
    {
      "unit_id": 37,
      "text": "* 4月—欧阳伯权，香港保险界人士，现任港铁公司主席。",
      "type": "list-item",
      "level": 2,
      "parent_id": 35
    },
    {
      "unit_id": 38,
      "text": "* 7月31日—胡大为，前香港电视节目主持人及电台节目主持，现已移居加拿大多伦多。",
      "type": "list-item",
      "level": 2,
      "parent_id": 35
    },
    {
      "unit_id": 39,
      "text": "* 9月6日—唐英年，香港著名纺织商人唐翔千长子，香港特别行政区第3任财政司司长第4任政务司司长。",
      "type": "list-item",
      "level": 2,
      "parent_id": 35
    },
    {
      "unit_id": 40,
      "text": "* 10月25日—严迅奇，香港建筑师。",
      "type": "list-item",
      "level": 2,
      "parent_id": 35
    },
    {
      "unit_id": 41,
      "text": "* 12月16日—梁家荣，前任香港电台广播处长，此前曾于无线新闻及亚视新闻出任记者、主播及高层。",
      "type": "list-item",
      "level": 2,
      "parent_id": 35
    },
    {
      "unit_id": 42,
      "text": "* 12月27日—林正英，香港已故知名演员（1997年离世）。",
      "type": "list-item",
      "level": 2,
      "parent_id": 35
    },
    {
      "unit_id": 43,
      "text": "* 本年—车菊红，香港已故前保龄球运动员，曾于1986年亚运会为香港夺得历来首个金牌（2021年离世）。",
      "type": "list-item",
      "level": 2,
      "parent_id": 35
    },
    {
      "unit_id": 44,
      "text": "逝世人物",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 45,
      "text": "* 2月11日，前国民党将领李福林。",
      "type": "list-item",
      "level": 2,
      "parent_id": 44
    }
  ]
}
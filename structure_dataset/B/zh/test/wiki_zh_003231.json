{
  "doc_id": "doc_001",
  "doc_name": "辉煌或疯狂",
  "language": "zh",
  "units": [
    {
      "unit_id": 0,
      "text": "《辉煌或疯狂》（빛나거나 미치거나，Shine or Go Crazy）为韩国MBC于2015年1月19日起播出的月火连续剧，本剧改编自玄高云作家的同名小说，由《天使的选择》、《Two Weeks》导演孙亨锡执导与权仁灿、金善美作家执笔，讲述了遭受诅咒的皇子和被遗弃的公主的罗曼史。收视率冠军。",
      "type": "title",
      "level": 0,
      "parent_id": null
    },
    {
      "unit_id": 1,
      "text": "演员阵容",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 2,
      "text": "主要人物",
      "type": "heading",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 3,
      "text": "* 张赫 饰演 王昭（粤语配音：陈健豪）\n高丽太祖第4子，后为高丽第4代皇帝",
      "type": "list-item",
      "level": 3,
      "parent_id": 2
    },
    {
      "unit_id": 4,
      "text": "* 吴涟序 饰演 晨燏（粤语配音：陈雪莹）\n渤海最后的公主，与王昭相恋",
      "type": "list-item",
      "level": 3,
      "parent_id": 2
    },
    {
      "unit_id": 5,
      "text": "* 李荷妮 饰演 皇甫丽援（粤语配音：庄巧怡）\n王尧、王昭之异母姊，与王昭国婚。欲助王昭登基成为皇后",
      "type": "list-item",
      "level": 3,
      "parent_id": 2
    },
    {
      "unit_id": 6,
      "text": "* 林周焕 饰演 王旭（粤语配音：黄龙杰）\n丽援亲弟，王尧、王昭之异母弟",
      "type": "list-item",
      "level": 3,
      "parent_id": 2
    },
    {
      "unit_id": 7,
      "text": "* 柳承秀 饰演 定宗 王尧（粤语配音：翟耀辉）\n高丽第3代皇帝，王昭亲兄，丽援、王旭之异母兄弟",
      "type": "list-item",
      "level": 3,
      "parent_id": 2
    },
    {
      "unit_id": 8,
      "text": "王昭相关人物",
      "type": "heading",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 9,
      "text": "* 李德华 饰演 王式廉（粤语配音：黄志成）\n太祖的堂弟",
      "type": "list-item",
      "level": 3,
      "parent_id": 8
    },
    {
      "unit_id": 10,
      "text": "* 金雷夏 饰演 殷川\n王昭的武士",
      "type": "list-item",
      "level": 3,
      "parent_id": 8
    },
    {
      "unit_id": 11,
      "text": "* 池秀媛 饰演 太后 刘氏（粤语配音：王慧珠）\n太祖的第三夫人，王昭、王尧的母亲",
      "type": "list-item",
      "level": 3,
      "parent_id": 8
    },
    {
      "unit_id": 12,
      "text": "* 申承焕 饰演 吉福\n王昭的侍从",
      "type": "list-item",
      "level": 3,
      "parent_id": 8
    },
    {
      "unit_id": 13,
      "text": "* 南庆邑 饰演 太祖 王建（粤语配音：谭汉华）\n高丽建国皇帝（特别演出第1-2集）",
      "type": "list-item",
      "level": 3,
      "parent_id": 8
    },
    {
      "unit_id": 14,
      "text": "* 池殷成 饰演 王源\n原型为孝隐太子 王垣，是太祖第9夫人东阳院庾氏的儿子",
      "type": "list-item",
      "level": 3,
      "parent_id": 8
    },
    {
      "unit_id": 15,
      "text": "* 朴善浩 饰演 王位\n太祖第6夫人贞德王后 刘氏之长子",
      "type": "list-item",
      "level": 3,
      "parent_id": 8
    },
    {
      "unit_id": 16,
      "text": "* 吕义柱 饰演 王琮\n太祖第21夫人西殿院夫人的儿子",
      "type": "list-item",
      "level": 3,
      "parent_id": 8
    },
    {
      "unit_id": 17,
      "text": "晨燏家",
      "type": "heading",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 18,
      "text": "* 许正民 饰演 梁奎达（粤语配音：袁德基）\n青海商团的首领，晨燏的义兄",
      "type": "list-item",
      "level": 3,
      "parent_id": 17
    },
    {
      "unit_id": 19,
      "text": "* 金善映 饰演 白妙（粤语配音：王慧珠）\n青海商团的行首，掌管人力资源",
      "type": "list-item",
      "level": 3,
      "parent_id": 17
    },
    {
      "unit_id": 20,
      "text": "* 安吉强 饰演 江明（粤语配音：谭汉华）\n青海商团的都房，负责商团治安",
      "type": "list-item",
      "level": 3,
      "parent_id": 17
    },
    {
      "unit_id": 21,
      "text": "* 丁宇埴 饰演 庆\n晨燏的武士",
      "type": "list-item",
      "level": 3,
      "parent_id": 17
    },
    {
      "unit_id": 22,
      "text": "* 李银雨 饰演 春娥\n青海商团清扫工",
      "type": "list-item",
      "level": 3,
      "parent_id": 17
    },
    {
      "unit_id": 23,
      "text": "* 郑在亨 饰演 小树\n春娥的儿子",
      "type": "list-item",
      "level": 3,
      "parent_id": 17
    },
    {
      "unit_id": 24,
      "text": "皇甫家",
      "type": "heading",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 25,
      "text": "* 金英宣 饰演 廉实\n皇甫丽援的随从",
      "type": "list-item",
      "level": 3,
      "parent_id": 24
    },
    {
      "unit_id": 26,
      "text": "* 罗钟赞 饰演 世元\n皇甫丽援的护卫武士，本名昊云",
      "type": "list-item",
      "level": 3,
      "parent_id": 24
    },
    {
      "unit_id": 27,
      "text": "王式廉家",
      "type": "heading",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 28,
      "text": "* 姜其永 饰演 王风\n王式廉之子",
      "type": "list-item",
      "level": 3,
      "parent_id": 27
    },
    {
      "unit_id": 29,
      "text": "* 朴贤宇 饰演 朴术（粤语配音：翟耀辉）\n王式廉忠诚的左右手",
      "type": "list-item",
      "level": 3,
      "parent_id": 27
    },
    {
      "unit_id": 30,
      "text": "豪族们与官吏们",
      "type": "heading",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 31,
      "text": "* 金秉玉 饰演 崔知梦(太祖-王建智囊.三崔之一)（粤语配音：袁德基）\n高丽内侍",
      "type": "list-item",
      "level": 3,
      "parent_id": 30
    },
    {
      "unit_id": 32,
      "text": "* 禹尚田 饰演 皇甫悌恭\n高丽开国功臣，皇甫家的豪族长，丽援的外公。",
      "type": "list-item",
      "level": 3,
      "parent_id": 30
    },
    {
      "unit_id": 33,
      "text": "* 徐范锡 饰演 王继（大总光）（粤语配音：翟耀辉）\n渤海最后的王子，晨燏的哥哥",
      "type": "list-item",
      "level": 3,
      "parent_id": 30
    },
    {
      "unit_id": 34,
      "text": "* 金镇浩 饰演 朴修庆\n平山出身的豪族",
      "type": "list-item",
      "level": 3,
      "parent_id": 30
    },
    {
      "unit_id": 35,
      "text": "* 李政勋 饰演 刘权律\n忠州家的豪族长，神明顺成王后的外家",
      "type": "list-item",
      "level": 3,
      "parent_id": 30
    },
    {
      "unit_id": 36,
      "text": "* 宋英才 饰演 刘木远\n平山家的豪族长",
      "type": "list-item",
      "level": 3,
      "parent_id": 30
    },
    {
      "unit_id": 37,
      "text": "* 安奭奂 饰演 金钟植\n洪州家的豪族长",
      "type": "list-item",
      "level": 3,
      "parent_id": 30
    },
    {
      "unit_id": 38,
      "text": "* 崔在浩 饰演 黄圭义\n海平家的豪族长",
      "type": "list-item",
      "level": 3,
      "parent_id": 30
    },
    {
      "unit_id": 39,
      "text": "* 金光植 饰演 白总贤\n东州家的豪族长",
      "type": "list-item",
      "level": 3,
      "parent_id": 30
    },
    {
      "unit_id": 40,
      "text": "月香楼",
      "type": "heading",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 41,
      "text": "* 陈瑞妍 饰演 琴善\n行首",
      "type": "list-item",
      "level": 3,
      "parent_id": 40
    },
    {
      "unit_id": 42,
      "text": "* 罗慧珍 饰演 清玉（粤语配音：王慧珠）\n妓女",
      "type": "list-item",
      "level": 3,
      "parent_id": 40
    },
    {
      "unit_id": 43,
      "text": "* 黄智妮 饰演 玲花\n妓女",
      "type": "list-item",
      "level": 3,
      "parent_id": 40
    },
    {
      "unit_id": 44,
      "text": "其他人物",
      "type": "heading",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 45,
      "text": "* 金范来 饰演 郭将军\n中国后汉时代将军，后拥立后主的人物。",
      "type": "list-item",
      "level": 3,

  "doc_id": "doc_001",
  "doc_name": "值言（9月11日），台湾女性轻小说作家。2011年获得第三届台湾角川轻小说暨插画大赏出道。。于2014年获尖端浮文字新人奖，2015年获东立原创大赛银赏。",
  "language": "zh",
  "units": [
    {
      "unit_id": 0,
      "text": "值言（9月11日），台湾女性轻小说作家。2011年获得第三届台湾角川轻小说暨插画大赏出道。。于2014年获尖端浮文字新人奖，2015年获东立原创大赛银赏。",
      "type": "title",
      "level": 0,
      "parent_id": null
    },
    {
      "unit_id": 1,
      "text": "奖项",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 2,
      "text": "* 2006年 织锦文学奖 短篇小说组 第二名",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 3,
      "text": "* 2006年 短篇小说〈呜噜哇的浆糊岛〉获教育部文艺创作奖优选",

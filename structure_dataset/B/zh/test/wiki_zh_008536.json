{
  "doc_id": "doc_001",
  "doc_name": "八户久慈自动车道",
  "language": "zh",
  "units": [
    {
      "unit_id": 0,
      "text": "八户久慈自动车道是从青森县八户市八戸ジャンクション至岩手县久慈市久慈インターチェンジ的快速公路。高速道路ナンバリング与三陆自动车道、三陆北縦贯道路被共同编为 E45 。",
      "type": "title",
      "level": 0,
      "parent_id": null
    },
    {
      "unit_id": 1,
      "text": "历史",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 2,
      "text": "* 1991年（平成3年）：八户南环状道路事业化。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 3,
      "text": "* 1993年（平成5年）12月16日：久慈道路・久慈北交流道 - 久慈交流道间 (3.2公里) 以暂定2车道启用。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 4,
      "text": "* 1995年（平成7年）：八户南道路事业着手。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 5,
      "text": "* 1999年（平成11年）：八户南环状道路开工。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 6,
      "text": "* 2002年（平成14年）：八户南道路开征道路用地。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 7,
      "text": "* 2003年（平成15年）：八户南道路开工。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 8,
      "text": "* 2005年（平成17年）3月5日：八户南环状道路・八户是川交流道 - 八户南交流道间 (3.8公里) 以暂定2车道启用。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 9,
      "text": "* 2006年（平成18年）：久慈道路设置救护车退出路。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 10,
      "text": "* 2007年（平成19年）6月16日：八户南道路・八户南交流道 - 种差海岸阶上岳交流道间 (3.4公里) 以暂定2车道启用。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 11,
      "text": "* 2011年（平成23年）12月11日：八户南环状道路・是川隧道开工。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 12,
      "text": "* 2013年（平成25年）3月9日：八户南道路・种差海岸阶上岳交流道 - 阶上交流道间 (5.3公里) 以暂定2车道启用。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 13,
      "text": "* 2013年（平成25年）3月24日：八户南环状道路・是川隧道完成。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 14,
      "text": "* 2014年（平成26年）3月29日：八户南环状道路・八户系统交流道 - 八户是川交流道间 (4.8 公里) 通车，八户南环状道路全线通车。以暂定2车道启用并与八户自动车道连接。同时间开设八户系统交流道收费站。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 15,
      "text": "交流道",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 16,
      "text": "各区间",
      "type": "heading",
      "level": 2,
      "parent_id": 15
    },
    {
      "unit_id": 17,
      "text": "八户南环状道路",
      "type": "heading",
      "level": 3,
      "parent_id": 16
    },
    {
      "unit_id": 18,
      "text": "八户南环状道路是日本青森县八户市内延长约8.6km的八户久慈自动车道（一般国道45号）一部份。现在使用中的是八户是川IC-八户南IC间3.8km。",
      "type": "paragraph",
      "level": 4,
      "parent_id": 17
    },
    {
      "unit_id": 19,
      "text": "* 起点：青森县八户市根城笹原",
      "type": "list-item",
      "level": 4,
      "parent_id": 17
    },
    {
      "unit_id": 20,
      "text": "* 终点：青森县八户市妙大开",
      "type": "list-item",
      "level": 4,
      "parent_id": 17
    },
    {
      "unit_id": 21,
      "text": "* 全长：8.6km",
      "type": "list-item",
      "level": 4,
      "parent_id": 17
    },
    {
      "unit_id": 22,
      "text": "* 规格：第1种第3级",
      "type": "list-item",
      "level": 4,
      "parent_id": 17
    },
    {
      "unit_id": 23,
      "text": "* 道路幅员：暂定12.0m（完成22.0m）",
      "type": "list-item",
      "level": 4,
      "parent_id": 17
    },
    {
      "unit_id": 24,
      "text": "* 车线数：暂定2车线（完成4车线）",
      "type": "list-item",
      "level": 4,
      "parent_id": 17
    },
    {
      "unit_id": 25,
      "text": "沿革",
      "type": "heading",
      "level": 4,
      "parent_id": 17
    },
    {
      "unit_id": 26,
      "text": "* 1991年（平成3年）度：事业化。",
      "type": "list-item",
      "level": 5,
      "parent_id": 25
    },
    {
      "unit_id": 27,
      "text": "* 1999年（平成11年）度：着工。",
      "type": "list-item",
      "level": 5,
      "parent_id": 25
    },
    {
      "unit_id": 28,
      "text": "* 2005年（平成17年）3月5日：八户是川IC-八户南IC间（3.8km）暂定2车线开始使用。",
      "type": "list-item",
      "level": 5,
      "parent_id": 25
    },
    {
      "unit_id": 29,
      "text": "* 2015年度：八户JCT-八户是川IC间予定使用(八户自动车道直结)",
      "type": "list-item",
      "level": 5,
      "parent_id": 25
    },
    {
      "unit_id": 30,
      "text": "出入口",
      "type": "heading",
      "level": 4,
      "parent_id": 17
    },
    {
      "unit_id": 31,
      "text": "* （八户JCT：予定）（八户自动车道）",
      "type": "list-item",
      "level": 5,
      "parent_id": 30
    },
    {
      "unit_id": 32,
      "text": "此间未开通",
      "type": "paragraph",
      "level": 5,
      "parent_id": 30
    },
    {
      "unit_id": 33,
      "text": "* 1 八户是川IC",
      "type": "list-item",
      "level": 5,
      "parent_id": 30
    },
    {
      "unit_id": 34,
      "text": "* 2 八户南IC（八户南道路）",
      "type": "list-item",
      "level": 5,
      "parent_id": 30
    },
    {
      "unit_id": 35,
      "text": "八户南道路",
      "type": "heading",
      "level": 3,
      "parent_id": 16
    },
    {
      "unit_id": 36,
      "text": "八户南道路是日本青森县八户市至三户郡阶上町延长约8.7km的八户久慈自动车道（一般国道45号）一部份。完成目标日期为2012年。。",
      "type": "paragraph",
      "level": 4,
      "parent_id": 35
    },
    {
      "unit_id": 37,
      "text": "* 起点：青森县八户市大字妙字大开",
      "type": "list-item",
      "level": 4,
      "parent_id": 35
    },
    {
      "unit_id": 38,
      "text": "* 终点：青森县三户郡阶上町道仏",
      "type": "list-item",
      "level": 4,
      "parent_id": 35
    },
    {
      "unit_id": 39,
      "text": "* 全长：8.7km",
      "type": "list-item",
      "level": 4,
      "parent_id": 35
    },
    {
      "unit_id": 40,
      "text": "* 规格：第1种第3级",
      "type": "list-item",
      "level": 4,
      "parent_id": 35
    },
    {
      "unit_id": 41,
      "text": "* 道路幅员：暂定12.0m（完成22.0m）",
      "type": "list-item",
      "level": 4,
      "parent_id": 35
    },
    {
      "unit_id": 42,
      "text": "* 车线数：暂定2车线（完成4车线）",
      "type": "list-item",
      "level": 4,
      "parent_id": 35
    },
    {
      "unit_id": 43,
      "text": "沿革",
      "type": "heading",
      "level": 4,
      "parent_id": 35
    },
    {
      "unit_id": 44,
      "text": "* 1995年（平成7年）度：事业着手。",
      "type": "list-item",
      "level": 5,
      "parent_id": 43
    },
    {
      "unit_id": 45,

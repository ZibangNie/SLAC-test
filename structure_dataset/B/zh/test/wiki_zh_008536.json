      "parent_id": 43
    },
    {
      "unit_id": 46,
      "text": "* 2003年（平成15年）度：工事着手。",
      "type": "list-item",
      "level": 5,
      "parent_id": 43
    },
    {
      "unit_id": 47,
      "text": "* 2007年（平成19年）6月16日：八户南IC～种差海岸阶上岳IC间（3.4km）暂定2车线开始使用。",
      "type": "list-item",

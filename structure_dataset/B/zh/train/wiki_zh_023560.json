    },
    {
      "unit_id": 57,
      "text": "万千光辉演艺人大奖",
      "type": "heading",
      "level": 3,
      "parent_id": 24
    },
    {
      "unit_id": 58,
      "text": " 得奖资料",
      "type": "paragraph",
      "level": 4,
      "parent_id": 57
    },
    {
      "unit_id": 59,
      "text": "中国内地最受欢迎TVB剧男、女艺人（颁奖礼前颁发）",
      "type": "heading",
      "level": 3,
      "parent_id": 24
    },
    {
      "unit_id": 60,
      "text": "颁奖典礼当晚座位",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 61,
      "text": "* 坐左边第一排由右至左的7位男艺人为黎耀祥、马国明、吴镇宇、张智霖、黄宗泽、陈豪及吴启华。",
      "type": "list-item",
      "level": 2,
      "parent_id": 60
    },
    {
      "unit_id": 62,
      "text": "* 坐右边第一排由左至右的6位女艺人为杨怡、胡杏儿、徐子珊、钟嘉欣、田蕊妮及周丽淇。",
      "type": "list-item",
      "level": 2,
      "parent_id": 60
    },
    {
      "unit_id": 63,
      "text": "纪录",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 64,
      "text": "* 黄子华：",
      "type": "list-item",
      "level": 2,
      "parent_id": 63
    },
    {
      "unit_id": 65,
      "text": "* #首位非加入无线电视出身或持有经理人／部头合约而夺得「最佳男主角」的男演员。",
      "type": "list-item",
      "level": 3,
      "parent_id": 64
    },
    {
      "unit_id": 66,
      "text": "* #首位缺席颁奖礼而仍夺得「最佳男主角」的男演员。",
      "type": "list-item",
      "level": 3,
      "parent_id": 64
    },
    {
      "unit_id": 67,
      "text": "* 田蕊妮：",
      "type": "list-item",
      "level": 2,
      "parent_id": 63
    },
    {
      "unit_id": 68,
      "text": "* #首位非于无线电视出身的「双料视后」（最佳女主角、最受欢迎电视女角色），也是第二位亚视出身的视后。",
      "type": "list-item",
      "level": 3,
      "parent_id": 67
    },
    {
      "unit_id": 69,
      "text": "* 许绍雄：",
      "type": "list-item",
      "level": 2,
      "parent_id": 63
    },
    {
      "unit_id": 70,
      "text": "* #成立以来，最年长的最佳男配角（65岁，1948年出生）(其后于万千星辉颁奖典礼2020由白彪（74岁，1946年出生）打破最年长的最佳男配角的纪录)。",
      "type": "list-item",
      "level": 3,
      "parent_id": 69
    },
    {
      "unit_id": 71,
      "text": "* 黄子华、许绍雄：",
      "type": "list-item",
      "level": 2,
      "parent_id": 63
    },
    {
      "unit_id": 72,
      "text": "* #两位所得奖剧集尚未播毕就分别获颁奖项的演员。",
      "type": "list-item",
      "level": 3,
      "parent_id": 71
    },
    {
      "unit_id": 73,
      "text": "* 欧阳震华：",
      "type": "list-item",
      "level": 2,
      "parent_id": 63
    },
    {
      "unit_id": 74,
      "text": "* #入围「最佳男主角」次数最多的男演员（14次，1997-2001年、2003-2008年、2010-2011年、2013年）。",
      "type": "list-item",
      "level": 3,
      "parent_id": 73
    },
    {
      "unit_id": 75,
      "text": "* 陈豪：",
      "type": "list-item",
      "level": 2,
      "parent_id": 63
    },
    {
      "unit_id": 76,
      "text": "* #最长连续入围「最佳男主角」的男演员（连续12年，2002-2013年）。",
      "type": "list-item",
      "level": 3,
      "parent_id": 75
    },
    {
      "unit_id": 77,
      "text": "* 萧正楠：",
      "type": "list-item",
      "level": 2,
      "parent_id": 63
    },
    {
      "unit_id": 78,
      "text": "* #成立以来，首位男演员于同一年提名所有固定四大个人奖项包括最佳男主角、最佳男配角、最受欢迎电视男角色、飞跃进步男艺员。",
      "type": "list-item",
      "level": 3,
      "parent_id": 77
    },
    {
      "unit_id": 79,
      "text": "* 刘丹：",
      "type": "list-item",
      "level": 2,
      "parent_id": 63
    },
    {
      "unit_id": 80,
      "text": "* #成立以来，最年长提名最佳男主角的男演员（69岁，1944年出生,其后于万千星辉颁奖典礼2020再次提名）。",
      "type": "list-item",
      "level": 3,
      "parent_id": 79
    },
    {
      "unit_id": 81,
      "text": "* 刘兆铭：",
      "type": "list-item",
      "level": 2,
      "parent_id": 63
    },
    {
      "unit_id": 82,
      "text": "* #成立以来，最年长的万千光辉演艺人大奖获奖者（82岁，1931年出生）。",
      "type": "list-item",
      "level": 3,
      "parent_id": 81
    },
    {
      "unit_id": 83,
      "text": "* 欧冠英：",
      "type": "list-item",
      "level": 2,
      "parent_id": 63
    },
    {
      "unit_id": 84,
      "text": "* #成立以来，首位首次担任监制，而其监制作品获得最佳剧集（冲上云霄II）。",
      "type": "list-item",
      "level": 3,
      "parent_id": 83
    },
    {
      "unit_id": 85,
      "text": "* 冲上云霄II：",
      "type": "list-item",
      "level": 2,
      "parent_id": 63
    },
    {
      "unit_id": 86,
      "text": "* #成立以来，首出双监制作品而获得最佳剧集。",
      "type": "list-item",
      "level": 3,
      "parent_id": 85
    },
    {
      "unit_id": 87,
      "text": "* #成立以来，首出延续第一部故事的续集获得最佳剧集。",
      "type": "list-item",
      "level": 3,
      "parent_id": 85
    },
    {
      "unit_id": 88,
      "text": "* 最佳男主角：",
      "type": "list-item",
      "level": 2,
      "parent_id": 63
    },
    {
      "unit_id": 89,
      "text": "* #除首届外，首次五强均未曾荣获此殊荣。",
      "type": "list-item",
      "level": 3,
      "parent_id": 88
    }
  ]
}
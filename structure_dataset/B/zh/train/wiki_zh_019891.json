{
  "doc_id": "doc_001",
  "doc_name": "1568年大事记",
  "language": "zh",
  "units": [
    {
      "unit_id": 0,
      "text": "1568年",
      "type": "title",
      "level": 0,
      "parent_id": null
    },
    {
      "unit_id": 1,
      "text": "大事记",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 2,
      "text": "明朝",
      "type": "heading",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 3,
      "text": "* 辽西走廊发生大地震。",
      "type": "list-item",
      "level": 3,
      "parent_id": 2
    },
    {
      "unit_id": 4,
      "text": "* 李春芳出任明朝首辅。",
      "type": "list-item",
      "level": 3,
      "parent_id": 2
    },
    {
      "unit_id": 5,
      "text": "* 5月15日——西安发生7级地震。",
      "type": "list-item",
      "level": 3,
      "parent_id": 2
    },
    {
      "unit_id": 6,
      "text": "日本",
      "type": "heading",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 7,
      "text": "* 武田信玄顺利策反上杉家臣本庄繁长跟越中豪族椎名康胤，爆发本庄繁长之乱。",
      "type": "list-item",
      "level": 3,
      "parent_id": 6
    },
    {
      "unit_id": 8,
      "text": "* 蒲生贤秀归顺织田信长。",
      "type": "list-item",
      "level": 3,
      "parent_id": 6
    },
    {
      "unit_id": 9,
      "text": "* 武田信玄家臣小山田信茂领兵越过小仏峠进攻相模，氏照派遣中山家范和横地吉信等人迎击，但是高尾山丽的廿里（现八王子市廿里町廿里古戦场）不敌。",
      "type": "list-item",
      "level": 3,
      "parent_id": 6
    },
    {
      "unit_id": 10,
      "text": "* 2月——足利义荣为松永久秀等人拥立为室町幕府第十四代将军。",
      "type": "list-item",
      "level": 3,
      "parent_id": 6
    },
    {
      "unit_id": 11,
      "text": "* 9月——织田信长进入京都，拥护足利义昭为室町幕府第十五代（末代）征夷大将军。",
      "type": "list-item",
      "level": 3,
      "parent_id": 6
    },
    {
      "unit_id": 12,
      "text": "* 12月——武田信玄发起骏河侵攻，相模北条氏政拒绝瓜分今川氏领地的提议，于是与德川家康结成瓜分今川氏领地的密约，甲相同盟破裂，后北条氏与上杉氏结成越相同盟。北条氏政仲介厩桥城的北条高广重归上杉氏，并亲率大军于萨多峠迫使兵力居劣势的武田军退兵，与德川家康缔结密约共同夹击武田信玄占领的骏河国。武田信玄鉴于兵锋受挫并考量骏河国难以防守，主动退回甲斐国，但今川氏真因骏河国人众与武田信玄内通叛变，被迫逃往家臣朝比奈泰朝于远江国的挂川城，德川家康接著对曳马城与挂川城发起攻击。",
      "type": "list-item",
      "level": 3,
      "parent_id": 6
    },
    {
      "unit_id": 13,
      "text": "欧洲",
      "type": "heading",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 14,
      "text": "* 奥图曼帝国大维齐尔索库鲁·穆罕默德帕夏建议塞利姆二世在伏尔加河与顿河之间掘一条运河支援中亚的突厥人对抗俄罗斯沙皇国，爆发俄土战争。",
      "type": "list-item",
      "level": 3,
      "parent_id": 13
    },
    {
      "unit_id": 15,
      "text": "* 《威廉·凡·那叟》被指定为荷兰国歌。",
      "type": "list-item",
      "level": 3,
      "parent_id": 13
    },
    {
      "unit_id": 16,
      "text": "* 瑞典国王埃里克十四世被议会废黜，约翰三世成为瑞典国王。",
      "type": "list-item",
      "level": 3,
      "parent_id": 13
    },
    {
      "unit_id": 17,
      "text": "* 波格丹四世登基成为摩尔多瓦统治者。",
      "type": "list-item",
      "level": 3,
      "parent_id": 13
    },
    {
      "unit_id": 18,
      "text": "* 葡萄牙国王塞巴斯蒂昂开始亲政。",
      "type": "list-item",
      "level": 3,
      "parent_id": 13
    },
    {
      "unit_id": 19,
      "text": "* 爱尔兰爆发反对英国的起义（直1573年被扑灭）。",
      "type": "list-item",
      "level": 3,
      "parent_id": 13
    },
    {
      "unit_id": 20,
      "text": "* 土达法令：个人宗教信仰自由。",
      "type": "list-item",
      "level": 3,
      "parent_id": 13
    },
    {
      "unit_id": 21,
      "text": "* 路德维希继位为符腾堡公爵。",
      "type": "list-item",
      "level": 3,
      "parent_id": 13
    },
    {
      "unit_id": 22,
      "text": "* 尤利乌斯继任为不伦瑞克-沃尔芬比特尔公爵。",
      "type": "list-item",
      "level": 3,
      "parent_id": 13
    },
    {
      "unit_id": 23,
      "text": "* 西班牙航海家发现图瓦卢和威克岛。西班牙航海探险家阿尔瓦罗·德·门达尼亚到达所罗门群岛。",
      "type": "list-item",
      "level": 3,
      "parent_id": 13
    },
    {
      "unit_id": 24,
      "text": "* 荷兰制图学者墨卡托创立了正轴等角圆柱投影。",
      "type": "list-item",
      "level": 3,
      "parent_id": 13
    },
    {
      "unit_id": 25,
      "text": "* 2月17日——神圣罗马帝国与鄂图曼帝国之间签订和平条约。",
      "type": "list-item",
      "level": 3,
      "parent_id": 13
    },
    {
      "unit_id": 26,
      "text": "* 3月23日——隆朱莫条约：法国第二次宗教战争结束，然而9月查理九世宣布废止原来有关和解、安定的诏令，法国第三次宗教战争再起。",
      "type": "list-item",
      "level": 3,
      "parent_id": 13
    },
    {
      "unit_id": 27,
      "text": "* 5月19日——英格兰的伊丽莎白一世女王将其表妹，苏格兰女王玛丽一世投入监狱。",
      "type": "list-item",
      "level": 3,
      "parent_id": 13
    },
    {
      "unit_id": 28,
      "text": "* 5月23日——荷兰争取从西班牙独立的八十年战争开始。",
      "type": "list-item",
      "level": 3,
      "parent_id": 13
    },
    {
      "unit_id": 29,
      "text": "东南亚",
      "type": "heading",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 30,
      "text": "* 缅甸东吁王朝再次出兵攻打暹罗阿瑜陀耶王朝，又称第三次阿瑜陀耶包围战。",
      "type": "list-item",
      "level": 3,
      "parent_id": 29
    },
    {
      "unit_id": 31,
      "text": "* 亚齐苏丹国与奥斯曼帝国组成联军围攻葡萄牙控制下的马六甲，虽然葡萄牙在柔佛苏丹支持下打退进攻，这场战役却使葡萄牙控制力大幅衰退。",
      "type": "list-item",
      "level": 3,
      "parent_id": 29
    },
    {
      "unit_id": 32,
      "text": "出生",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 33,
      "text": "* 魏忠贤，明朝宦官（逝世于1627年）",
      "type": "list-item",
      "level": 2,
      "parent_id": 32
    },
    {
      "unit_id": 34,
      "text": "* 官应震，明朝大臣（逝世于1635年）",
      "type": "list-item",
      "level": 2,
      "parent_id": 32
    },
    {
      "unit_id": 35,
      "text": "* 丰臣秀次，日本战国时代将军（逝世于1595年）",
      "type": "list-item",
      "level": 2,
      "parent_id": 32
    },
    {
      "unit_id": 36,
      "text": "* 羽柴秀胜，日本武将（逝世于1586年）",
      "type": "list-item",
      "level": 2,
      "parent_id": 32
    },
    {
      "unit_id": 37,
      "text": "* 石川五右卫门，日本大盗（约出生于1568年，逝世于1594年）",
      "type": "list-item",
      "level": 2,
      "parent_id": 32
    },
    {
      "unit_id": 38,
      "text": "* 袁宏道，明朝文人（逝世于1610年）",
      "type": "list-item",
      "level": 2,
      "parent_id": 32
    },
    {
      "unit_id": 39,
      "text": "* 曾鲸，明朝画家（逝世于1650年）",
      "type": "list-item",
      "level": 2,
      "parent_id": 32
    },
    {
      "unit_id": 40,
      "text": "* 吉田政重，日本家臣（逝世于1628年）",
      "type": "list-item",
      "level": 2,
      "parent_id": 32
    },
    {
      "unit_id": 41,
      "text": "* 1月——立花成家，日本贵族（约出生于1568年，逝世于1620年）",
      "type": "list-item",
      "level": 2,
      "parent_id": 32
    },
    {
      "unit_id": 42,
      "text": "* 4月5日——乌尔巴诺八世，教宗（逝世于1644年）",
      "type": "list-item",
      "level": 2,
      "parent_id": 32
    },
    {
      "unit_id": 43,
      "text": "* 12月21日——黑田长政，日本武将（逝世于1622年）",
      "type": "list-item",
      "level": 2,
      "parent_id": 32
    },
    {
      "unit_id": 44,
      "text": "逝世",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 45,
      "text": "* 亚历山德鲁·勒普什内亚努，摩尔多瓦统治者",
      "type": "list-item",
      "level": 2,
      "parent_id": 44
    },
    {
      "unit_id": 46,
      "text": "* 李开先，明朝作家（出生于1502年）",
      "type": "list-item",
      "level": 2,
      "parent_id": 44
    },
    {
      "unit_id": 47,
      "text": "* 中条藤资，日本家臣（出生年代不明）",
      "type": "list-item",
      "level": 2,
      "parent_id": 44
    },
    {
      "unit_id": 48,
      "text": "* 寿桂尼，日本大名今川氏亲的正室（出生时间不详）",
      "type": "list-item",
      "level": 2,
      "parent_id": 44
    },
    {
      "unit_id": 49,
      "text": "* 2月7日——色部胜长，日本家臣（出生于1493年）",
      "type": "list-item",
      "level": 2,
      "parent_id": 44
    },
    {
      "unit_id": 50,
      "text": "* 6月11日——亨利二世，不伦瑞克-沃尔芬比特尔公爵（出生于1489年）",
      "type": "list-item",
      "level": 2,
      "parent_id": 44
    },
    {
      "unit_id": 51,
      "text": "* 12月28日——克里斯托夫，符腾堡公爵（出生于1515年）",
      "type": "list-item",
      "level": 2,
      "parent_id": 44
    }
  ]
}
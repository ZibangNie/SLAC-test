{
  "doc_id": "doc_001",
  "doc_name": "新营工业区",
  "language": "zh",
  "units": [
    {
      "unit_id": 0,
      "text": "新营工业区",
      "type": "title",
      "level": 0,
      "parent_id": null
    },
    {
      "unit_id": 1,
      "text": "新营工业区于1982年2月由台南县政府与台湾土地开发信托投资共同开发，再由台湾省政府建设厅工程技术服务中心规划设计，经历1年8个月于1983年10月开发完成。",
      "type": "paragraph",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 2,
      "text": "土地面积",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 3,
      "text": "总面积124公顷，其中可供厂商从事生产面积103.6公顷，占整体83.44%。",
      "type": "paragraph",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 4,
      "text": "园区邻近国道一号新营交流道西侧，格局方正，四周被国道1号，台19甲线，市道172号，区道72线(太子路)所包围。",
      "type": "paragraph",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 5,
      "text": "厂商概况",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 6,
      "text": "目前营运中的厂商136家、停工3家、歇业18家，合计共157家。",
      "type": "paragraph",
      "level": 2,
      "parent_id": 5
    },

{
  "doc_id": "doc_001",
  "doc_name": "亚莲冬马",
  "language": "zh",
  "units": [
    {
      "unit_id": 0,
      "text": "亚莲冬马",
      "type": "title",
      "level": 0,
      "parent_id": null
    },
    {
      "unit_id": 1,
      "text": "亚莲 冬马（9月9日出生）神奈川县茅崎市出身，宝冢歌剧团99期生，元宝冢歌剧团花组所属男役。",
      "type": "paragraph",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 2,
      "text": "个人档案",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 3,
      "text": "亚莲冬马（Anri,あれん), 2011年第11名作为99期生入学宝冢音乐学校，以第6名成绩卒业（卒业生共37人），研究生一年考核后排名第5。2014年2月11日配属至花组男役。",
      "type": "paragraph",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 4,
      "text": "出生：9月9日",
      "type": "list-item",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 5,
      "text": "出身地：神奈川县茅崎市",
      "type": "list-item",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 6,
      "text": "毕业学校：湘南白百合学园中学",
      "type": "list-item",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 7,
      "text": "身高：175cm",
      "type": "list-item",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 8,
      "text": "初舞台时间：2013年4月雪组公演《ベルサイユのばら－フェルゼン编－》",
      "type": "list-item",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 9,
      "text": "喜欢的角色：《伊丽莎白》黑天使役, 《スターダム》ジェイク役",
      "type": "list-item",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 10,
      "text": "兴趣：海外旅行，骑马，电影欣赏",
      "type": "list-item",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 11,
      "text": "正在收集的物品：有机栽培得东西",
      "type": "list-item",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 12,
      "text": "喜欢的花：卡萨布兰卡，满天星",
      "type": "list-item",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 13,
      "text": "喜欢的颜色：深蓝",
      "type": "list-item",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 14,
      "text": "喜欢的食物：水果，酸奶， 沙冰",
      "type": "list-item",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 15,
      "text": "特技： 英语， 长拳",
      "type": "list-item",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 16,
      "text": "艺名的由来： 家人参考",
      "type": "list-item",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 17,
      "text": "英文名： Allen",
      "type": "list-item",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 18,
      "text": "爱称： Anri, あれん",
      "type": "list-item",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 19,
      "text": "工作时间外最感兴趣的事：到休息日会去做按摩缓解一周的疲劳，以崭新的心态面对新的一周的开始。",
      "type": "list-item",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 20,
      "text": "宝冢舞台经历",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 21,
      "text": "初舞台",
      "type": "heading",
      "level": 2,
      "parent_id": 20
    },
    {
      "unit_id": 22,
      "text": "* 2013年4月－5月， 雪组大剧场《ベルサイユのばら－フェルゼン编－》",
      "type": "list-item",
      "level": 3,
      "parent_id": 21
    },
    {
      "unit_id": 23,
      "text": "组回",
      "type": "heading",
      "level": 2,
      "parent_id": 20
    },
    {
      "unit_id": 24,
      "text": "* 2013年8月－2013年11月， 花组大剧场《爱と革命の诗（うた）－アンドレア・シェニエ－》《Mr. Swing!》",
      "type": "list-item",
      "level": 3,
      "parent_id": 23
    },
    {
      "unit_id": 25,
      "text": "花组配属后",
      "type": "heading",
      "level": 2,
      "parent_id": 20
    },
    {
      "unit_id": 26,
      "text": "* 2014年6月，  宝冢Bow Hall 公演《ノクターン－远い夏の日の记忆－》イーゴリ",
      "type": "list-item",
      "level": 3,
      "parent_id": 25
    },
    {
      "unit_id": 27,
      "text": "* 2014年8月－11月，宝冢大剧场/东京宝冢大剧场《エリザベート - 爱と死の轮舞 -》黒天使，新人公演：ジュラ（本役：芹香斗亜・柚香光）",
      "type": "list-item",
      "level": 3,
      "parent_id": 25
    },
    {
      "unit_id": 28,
      "text": "* 2014年12月， 宝冢大剧场《Takarazuka Speical - Thank you for 100 years》",
      "type": "list-item",
      "level": 3,
      "parent_id": 25
    },
    {
      "unit_id": 29,
      "text": "* 2015年1月， 梅田艺术剧场／日本青年馆 《风の次郎吉　―大江戸夜飞翔―》吉次",
      "type": "list-item",
      "level": 3,
      "parent_id": 25
    },
    {
      "unit_id": 30,
      "text": "* 2015年3月－6月，宝冢大剧场/东京宝冢大剧场《カリスタの海に抱かれて》《宝冢幻想曲》新人公演：ドナード・インザーキ（本役：羽立光来）",
      "type": "list-item",
      "level": 3,
      "parent_id": 25
    },
    {
      "unit_id": 31,
      "text": "* 2015年7月－8月，宝冢Bow Hall 公演《スターダム》ジェイク",
      "type": "list-item",
      "level": 3,
      "parent_id": 25
    },
    {
      "unit_id": 32,
      "text": "* 2015年10月－12月， 宝冢大剧场/东京宝冢大剧场《新源氏物语》《Melodia -热く美しき旋律-》蜂丸 ，新人公演：兵部大辅（本役：和海 しょう）",
      "type": "list-item",
      "level": 3,
      "parent_id": 25
    },
    {
      "unit_id": 33,
      "text": "* 2016年2月－3月， 梅田艺术剧场／KAAT神奈川芸术剧场公演 《For the people —リンカーン 自由を求めた男—》 ブランドン／ロバート・リンカーン（ボビー）",
      "type": "list-item",
      "level": 3,
      "parent_id": 25
    },
    {
      "unit_id": 34,
      "text": "* 2016年4月－7月，宝冢大剧场/东京宝冢大剧场《ME AND MY GIRL 》，新人公演：ジョン・トレメイン卿（宝冢：一幕、东京：二幕、本役：芹香斗亜・瀬戸かずや）",
      "type": "list-item",
      "level": 3,
      "parent_id": 25
    },
    {
      "unit_id": 35,
      "text": "* 2016年8月， 宝冢 Bow Hall 公演 《Bow Singing Workshop》",
      "type": "list-item",
      "level": 3,
      "parent_id": 25
    },
    {
      "unit_id": 36,
      "text": "* 2016年9月， 宝冢Bow Hall 公演 《アイラブアインシュタイン》 ヴォルフ／エドゥアルト",
      "type": "list-item",
      "level": 3,
      "parent_id": 25
    },
    {
      "unit_id": 37,
      "text": "* 2016年11月－2017年2月， 宝冢大剧场/东京宝冢大剧场《雪华抄（せっかしょう）》《金色（こんじき）の砂漠》，新人公演：ジャー（イスファン国の奴隷）（本役：芹香斗亜）",
      "type": "list-item",
      "level": 3,
      "parent_id": 25
    },
    {
      "unit_id": 38,
      "text": "* 2017年4月， 星条海斗ディナーショー《MASQUERADE》（第一ホテル东京・宝冢ホテル）",
      "type": "list-item",
      "level": 3,
      "parent_id": 25
    },
    {
      "unit_id": 39,
      "text": "* 2017年6月～8月，宝冢大剧场/东京宝冢大剧场《邪马台国の风／Santé\n～最高级ワインをあなたに～》タタラ，新人公演：ジアシラ（邪马台国の兵の长）（本役：凤月杏）",
      "type": "list-item",
      "level": 3,
      "parent_id": 25
    },
    {
      "unit_id": 40,
      "text": "* 2017年10月， 梅田艺术剧场／日本青年馆 《はいからさんが通る》高屋敷要",
      "type": "list-item",
      "level": 3,
      "parent_id": 25
    },
    {
      "unit_id": 41,
      "text": "* 2018年1月～3月，宝冢大剧场/东京宝冢大剧场《ポーの一族》ロッド／サミー ，新人公演：ジャン・クリフォード（本役：凤月杏）",
      "type": "list-item",
      "level": 3,
      "parent_id": 25
    },
    {
      "unit_id": 42,
      "text": "* 2018年5月，《あかねさす紫の花／Santé\n～最高级ワインをあなたに～》（博多座）矢坂部连仓目",
      "type": "list-item",
      "level": 3,
      "parent_id": 25
    },
    {
      "unit_id": 43,
      "text": "* 2018年7月-10月，《MESSIAH−异闻・天草四郎−／BEAUTIFUL GARDEN −百花缭乱−》多闻丸、新人公演：渡辺小左卫门（本役：瀬戸 かずや）（7月19日腿伤休演）",
      "type": "list-item",
      "level": 3,
      "parent_id": 25
    },
    {
      "unit_id": 44,
      "text": "* 2018年11月-12月，《メランコリック・ジゴロ -あぶない相続人-／EXCITER\n2018》（全国ツアー）（腿部手术康复中，全日程休演）",
      "type": "list-item",
      "level": 3,
      "parent_id": 25
    },
    {
      "unit_id": 45,
      "text": "* 2018年12月25日，《CASANOVA》 集合日宣布退团",
      "type": "list-item",
      "level": 3,
      "parent_id": 25
    },
    {
      "unit_id": 46,
      "text": "宝冢退团后活动",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 47,
      "text": "* 使用本名“白井杏莉”Instagram活跃中",
      "type": "list-item",
      "level": 2,
      "parent_id": 46
    },
    {
      "unit_id": 48,
      "text": "* 和妹妹一起创立休闲服装品牌 DADATWSIE",
      "type": "list-item",
      "level": 2,
      "parent_id": 46
    },
    {
      "unit_id": 49,
      "text": "* 现在倾向Youtuber/KOL发展",
      "type": "list-item",
      "level": 2,
      "parent_id": 46
    }
  ]
}
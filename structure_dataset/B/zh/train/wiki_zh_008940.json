{
  "doc_id": "doc_001",
  "doc_name": "澳门海关",
  "language": "zh",
  "units": [
    {
      "unit_id": 0,
      "text": "澳门海关（Serviços de Alfândega de Macau，Macao Customs），是澳门特别行政区政府部门，成立于2001年11月1日，每年11月6日为纪念日，即海关日。海关关长需要由澳门行政长官提名，报请中华人民共和国中央人民政府任命。",
      "type": "title",
      "level": 0,
      "parent_id": null
    },
    {
      "unit_id": 1,
      "text": "职责",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 2,
      "text": "预防、打击和遏止关务欺诈行为；",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 3,
      "text": "致力预防和遏止不法贩运活动；",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 4,
      "text": "配合对外贸易活动的监管工作，并为发展对外贸易活动作出贡献，以维护澳门特别行政区在国际上的信誉；",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 5,
      "text": "根据法例，确保对知识产权的保护；",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 6,
      "text": "致力履行澳门特别行政区在海关范畴内承担的国际义务；",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 7,
      "text": "致力保护人身和财产安全，妥善执行澳门特别行政区的内部保安政策；",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 8,
      "text": "参与澳门特别行政区的民防工作，并在紧急情况中参与行动。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 9,
      "text": "组织法例",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 10,
      "text": "第11/2001号法律（2001年8月6日《澳门特别行政区公报》）设立中华人民共和国澳门特别行政区海关-若干废止。",
      "type": "list-item",
      "level": 2,
      "parent_id": 9
    },
    {
      "unit_id": 11,
      "text": "第21/2001号行政法规（2001年10月22日《澳门特别行政区公报》）核准海关的组织与运作。",
      "type": "list-item",
      "level": 2,
      "parent_id": 9
    },
    {
      "unit_id": 12,
      "text": "第1/2002号法律（2002年2月4日《澳门特别行政区公报》）订定澳门特别行政区海关人员的刑事警察当局身份。",
      "type": "list-item",
      "level": 2,
      "parent_id": 9
    },
    {
      "unit_id": 13,
      "text": "第9/2002号法律（2002年12月9日《澳门特别行政区公报》）订定澳门特别行政区内部保安纲要法。",
      "type": "list-item",
      "level": 2,
      "parent_id": 9
    },
    {
      "unit_id": 14,
      "text": "第3/2003号法律（2003年2月24日《澳门特别行政区公报》）海关关员职程、职位及报酬制度。",
      "type": "list-item",
      "level": 2,
      "parent_id": 9
    },
    {
      "unit_id": 15,
      "text": "第4/2003号行政法规（2003年4月14日《澳门特别行政区公报》）修改海关关员编制和订定海关关员职程内各职级的职位及职能。",
      "type": "list-item",
      "level": 2,
      "parent_id": 9
    },
    {
      "unit_id": 16,
      "text": "第135/2003号行政长官批示（2003年5月26日《澳门特别行政区公报》）核准澳门特别行政区海关关长、具有刑事警察当局身份的海关人员、海关关员及其他海关人员使用的工作证式样。",
      "type": "list-item",
      "level": 2,
      "parent_id": 9
    },
    {
      "unit_id": 17,
      "text": "第1/2004号行政法规（2004年1月5日《澳门特别行政区公报》）订定海关关员职程的入职及晋升制度。",
      "type": "list-item",
      "level": 2,
      "parent_id": 9
    },
    {
      "unit_id": 18,
      "text": "第4/2006号法律（2006年5月15日《澳门特别行政区公报》）修改保安部门及保安部队若干人员组别的薪俸点。",
      "type": "list-item",
      "level": 2,
      "parent_id": 9
    },
    {
      "unit_id": 19,
      "text": "第2/2008号法律（2008年4月21日《澳门特别行政区公报》）重组保安部队及保安部门职程。",
      "type": "list-item",
      "level": 2,
      "parent_id": 9
    },
    {
      "unit_id": 20,
      "text": "第8/2008号行政法规（2008年4月28日《澳门特别行政区公报》）调整保安部队及保安部门人员编制。",
      "type": "list-item",
      "level": 2,
      "parent_id": 9
    },
    {
      "unit_id": 21,
      "text": "第14/2008号行政法规（2008年6月23日《澳门特别行政区公报》）修改订定《海关关员职程的入职及晋升制度》的第1/2004号行政法规。",
      "type": "list-item",
      "level": 2,
      "parent_id": 9
    },
    {
      "unit_id": 22,
      "text": "第25/2008号行政法规（2008年12月1日《澳门特别行政区公报》）修改海关的组织及运作。",
      "type": "list-item",
      "level": 2,
      "parent_id": 9
    },
    {
      "unit_id": 23,
      "text": "第44/2010号行政命令（2010年6月7日《澳门特别行政区公报》）海关的文职人员编制。",
      "type": "list-item",
      "level": 2,
      "parent_id": 9
    },
    {
      "unit_id": 24,
      "text": "第4/2011号行政法规（2011年1月31日《澳门特别行政区公报》）修改订定《海关关员职程的入职及晋升制度》的第1/2004号行政法规。",
      "type": "list-item",
      "level": 2,
      "parent_id": 9
    },
    {
      "unit_id": 25,
      "text": "组织架构",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 26,
      "text": "历史",
      "type": "heading",
      "level": 2,
      "parent_id": 25
    },
    {
      "unit_id": 27,
      "text": "1822年9月2日，成立港务局。",
      "type": "list-item",
      "level": 3,
      "parent_id": 26
    },
    {
      "unit_id": 28,
      "text": "1841年3月3日，成立港口警察。",
      "type": "list-item",
      "level": 3,
      "parent_id": 26
    },
    {
      "unit_id": 29,
      "text": "1862年7月26日，成立海事警察。",
      "type": "list-item",
      "level": 3,
      "parent_id": 26
    },
    {
      "unit_id": 30,
      "text": "1862年11月18日，易名澳门港口海事警察。",
      "type": "list-item",
      "level": 3,
      "parent_id": 26
    },
    {
      "unit_id": 31,
      "text": "1868年9月3日，易名澳门港口警察，隶属于港务局局长。",
      "type": "list-item",
      "level": 3,
      "parent_id": 26
    },
    {
      "unit_id": 32,
      "text": "1957年11月25日，水警稽查队由以往港口警察及稽查警察合并而成。",
      "type": "list-item",
      "level": 3,
      "parent_id": 26
    },
    {
      "unit_id": 33,
      "text": "1975年12月27日，澳门保安部队成立。",
      "type": "list-item",
      "level": 3,
      "parent_id": 26
    },
    {
      "unit_id": 34,
      "text": "1976年1月1日，水警稽查队由保安部队统一指挥。",
      "type": "list-item",
      "level": 3,
      "parent_id": 26
    },
    {
      "unit_id": 35,
      "text": "1999年12月20日，水警稽查队易名水警稽查局。",
      "type": "list-item",
      "level": 3,
      "parent_id": 26
    },
    {
      "unit_id": 36,
      "text": "2001年11月1日，撤销水警稽查局，成立澳门海关，每年11月6日为纪念日，亦即海关日。海关行使水警稽查队全部职能，亦行使经济局（打击侵权）及劳工事务局（打击黑工）部分职能。",
      "type": "list-item",
      "level": 3,
      "parent_id": 26
    },
    {
      "unit_id": 37,
      "text": "历任关长",
      "type": "heading",
      "level": 2,
      "parent_id": 25
    },
    {
      "unit_id": 38,
      "text": "徐礼恒（1999年12月20日—2014年12月19日）",
      "type": "list-item",
      "level": 3,
      "parent_id": 37
    },
    {
      "unit_id": 39,
      "text": "赖敏华（2014年12月20日— 2015年10月30日（任内去世））",
      "type": "list-item",
      "level": 3,
      "parent_id": 37
    },
    {
      "unit_id": 40,
      "text": "* 黄少泽（2015年10月30日开始兼任）",
      "type": "list-item",
      "level": 3,
      "parent_id": 37
    },
    {
      "unit_id": 41,
      "text": "黄有力（2016年2月22日—2019年12月19日）",
      "type": "list-item",
      "level": 3,
      "parent_id": 37
    },
    {
      "unit_id": 42,
      "text": "黄文忠（2019年12月20日—）",
      "type": "list-item",
      "level": 3,
      "parent_id": 37
    },

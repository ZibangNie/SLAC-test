    {
      "unit_id": 54,
      "text": "编制",
      "type": "heading",
      "level": 2,
      "parent_id": 25
    },
    {
      "unit_id": 55,
      "text": "2001年：1,201名",
      "type": "list-item",
      "level": 3,
      "parent_id": 54
    },
    {
      "unit_id": 56,
      "text": "2013年：1,660名",
      "type": "list-item",
      "level": 3,
      "parent_id": 54
    },
    {
      "unit_id": 57,
      "text": "徽号",
      "type": "heading",
      "level": 2,
      "parent_id": 25
    },
    {
      "unit_id": 58,
      "text": "设计沿自水警稽查队及水警稽查局的徽号",
      "type": "paragraph",
      "level": 3,
      "parent_id": 57
    },
    {
      "unit_id": 59,
      "text": "中心的钥匙，象征澳门海关的关务职能",
      "type": "list-item",
      "level": 3,
      "parent_id": 57
    },
    {
      "unit_id": 60,
      "text": "中心的船锚，象征澳门海关的船队职能",
      "type": "list-item",
      "level": 3,
      "parent_id": 57
    },
    {
      "unit_id": 61,
      "text": "中圈三色环，象征澳门海关的警务职能，浅蓝代表天空，蓝色代表海洋，绿色代表陆地，象征关员职责在陆地上守望天空与海洋，或在海上守望天空与陆地。",
      "type": "list-item",
      "level": 3,
      "parent_id": 57
    },
    {
      "unit_id": 62,
      "text": "荣誉",
      "type": "heading",
      "level": 2,
      "parent_id": 25
    },
    {
      "unit_id": 63,
      "text": "知识产权厅在2005年获澳门政府授予英勇奖章。",
      "type": "list-item",
      "level": 3,
      "parent_id": 62
    },
    {
      "unit_id": 64,
      "text": "潜水队在2017年获澳门政府授予英勇奖章。",
      "type": "list-item",
      "level": 3,
      "parent_id": 62
    },
    {
      "unit_id": 65,

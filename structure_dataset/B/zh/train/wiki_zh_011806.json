    },
    {
      "unit_id": 35,
      "text": "* 湖南省福利彩票发行中心（湖南省社会福利有奖募捐委员会办公室）",
      "type": "list-item",
      "level": 3,
      "parent_id": 30
    },
    {
      "unit_id": 36,
      "text": "* 湖南省慈善总会办公室",
      "type": "list-item",
      "level": 3,
      "parent_id": 30
    },
    {

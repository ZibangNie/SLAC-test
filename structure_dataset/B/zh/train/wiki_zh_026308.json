  "doc_id": "doc_001",
  "doc_name": "路德会西门英才中学（Gertrude Simon Lutheran College）",
  "language": "zh",
  "units": [
    {
      "unit_id": 0,
      "text": "路德会西门英才中学（Gertrude Simon Lutheran College），简称西英，是香港新界元朗区的一所男女校文法中学，校舍位于新界元朗公园北路，邻近元朗公园和元朗大球场。校训是「你们是世上的光」（马太 5:14）。该校现时与深圳市美中学校与深圳市北环中学结为姊妹学校。此外，前中国女子排球运动员孙玥为该校的排球校队教练。",
      "type": "title",
      "level": 0,
      "parent_id": null
    },

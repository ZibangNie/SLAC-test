    {
      "unit_id": 51,
      "text": "淘汰赛",
      "type": "heading",
      "level": 2,
      "parent_id": 27
    },
    {
      "unit_id": 52,
      "text": "除决赛外，淘汰赛各阶段均会进行两轮赛事，两支队伍均会有一次主场作赛机会。于两轮赛事总比数胜出之队伍将晋级下一回合，若两轮赛事之总比分打平，将计算作客入球，作客入球较多之一队获得晋级。而决赛将为一场过，于爱尔兰都柏林英杰华球场进行。",
      "type": "paragraph",
      "level": 3,
      "parent_id": 51
    },
    {
      "unit_id": 53,
      "text": "晋级图",
      "type": "heading",
      "level": 3,
      "parent_id": 51
    },
    {
      "unit_id": 54,
      "text": "三十二强",
      "type": "heading",
      "level": 4,
      "parent_id": 53
    },
    {
      "unit_id": 55,
      "text": "三十二强抽签于2010年12月17日进行。首回合赛事将于2011年2月17日进行，而次回合赛事将于2011年2月24日进行。",
      "type": "paragraph",
      "level": 5,
      "parent_id": 54
    },
    {
      "unit_id": 56,
      "text": "十六强",
      "type": "heading",
      "level": 4,
      "parent_id": 53
    },
    {
      "unit_id": 57,
      "text": "十六强首回合赛事将于2011年3月10日进行，而次回合赛事将于2011年3月17日进行。",
      "type": "paragraph",
      "level": 5,
      "parent_id": 56
    },
    {
      "unit_id": 58,
      "text": "半准决赛",
      "type": "heading",
      "level": 4,
      "parent_id": 53
    },
    {
      "unit_id": 59,
      "text": "半准决赛抽签于2011年3月18日进行。首回合赛事将于2011年4月7日进行，而次回合赛事将于2011年4月14日进行。",
      "type": "paragraph",
      "level": 5,
      "parent_id": 58
    },
    {
      "unit_id": 60,
      "text": "准决赛",
      "type": "heading",
      "level": 4,
      "parent_id": 53
    },
    {
      "unit_id": 61,
      "text": "准决赛首回合赛事将于2011年4月28日进行，而次回合赛事将于2011年5月5日进行。",
      "type": "paragraph",
      "level": 5,
      "parent_id": 60
    },
    {
      "unit_id": 62,
      "text": "决赛",
      "type": "heading",
      "level": 4,
      "parent_id": 53
    },
    {
      "unit_id": 63,
      "text": "决赛会以一场过进行，于2011年5月18日，在爱尔兰都柏林英杰华球场进行。",
      "type": "paragraph",
      "level": 5,
      "parent_id": 62
    }

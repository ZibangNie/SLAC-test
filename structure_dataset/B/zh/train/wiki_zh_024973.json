{
  "doc_id": "doc_001",
  "doc_name": "旭日章",
  "language": "zh",
  "units": [
    {
      "unit_id": 0,
      "text": "旭日章",
      "type": "title",
      "level": 0,
      "parent_id": null
    },
    {
      "unit_id": 1,
      "text": "旭日章，日本勋章的一种。1875年4月10日制定，2003年11月3日更正。授与“对国家公共有功劳者中，有引人瞩目的显著功绩内容”。比起瑞宝章的授与对象更为狭窄。",
      "type": "paragraph",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 2,
      "text": "种类",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 3,
      "text": "旭日大绶章（原勋一等旭日大绶章）",
      "type": "list-item",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 4,
      "text": "旭日重光章（原勋二等旭日重光章）",
      "type": "list-item",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 5,
      "text": "旭日中绶章（原勋三等旭日中绶章）",
      "type": "list-item",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 6,
      "text": "旭日小绶章（原勋四等旭日小绶章）",
      "type": "list-item",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 7,
      "text": "旭日双光章（原勋五等双光旭日章）",
      "type": "list-item",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 8,
      "text": "旭日单光章（原勋六等单光旭日章）",
      "type": "list-item",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 9,
      "text": "订定时分为勋一等至勋八等，从最上阶依序排列为勋一等旭日大绶章、勋二等旭日重光章、勋三等旭日中绶章、勋四等旭日小绶章、勋五等双光旭日章、勋六等单光旭日章、勋七等青色桐叶章、勋八等白色桐叶章。但是只授与男性。1888年1月4日将最上阶的勋章勋一等旭日大绶章定为勋一等旭日桐花大绶章。随著瑞宝章的制定，位阶定位在瑞宝章之上。2003年荣典制度改革，只能授与男性的条件与社会情势不合，女性也成为得授与的对象。同时，最上阶的旭日桐花大授章独立为桐花章（桐花大绶章），并废止桐叶章，只留下6个阶级。并将双光旭日章、单光旭日章改名为旭日双光章、旭日单光章。",
      "type": "paragraph",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 10,
      "text": "勋章设计",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 11,
      "text": "有著八角的旭光的日章。「钮」的造型使用桐花的花叶。「绶」为白底搭配双红线。",
      "type": "paragraph",
      "level": 2,
      "parent_id": 10
    },
    {
      "unit_id": 12,
      "text": "部分获奖者",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 13,
      "text": "下濑雅允（1893年勋五等双光旭日章、1906年勋三等旭日中绶章，日本发明家、工程学博士，发明下濑火药）",
      "type": "list-item",
      "level": 2,
      "parent_id": 12
    },
    {
      "unit_id": 14,
      "text": "荒胜文策（1974年勋二等旭日重光章，高能物理学家）",
      "type": "list-item",
      "level": 2,
      "parent_id": 12
    },

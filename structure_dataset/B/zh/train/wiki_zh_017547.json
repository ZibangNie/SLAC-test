{
  "doc_id": "doc_001",
  "doc_name": "石泽良昭",
  "language": "ja",
  "units": [
    {
      "unit_id": 0,
      "text": "石泽良昭",
      "type": "title",
      "level": 0,
      "parent_id": null
    },
    {
      "unit_id": 1,
      "text": "石泽 良昭是一名日本的历史学家，第13代上智大学校长。専门是东南亚史、柬埔寨王国的吴哥窟时代碑刻文解读研究。目前担任上智大学亚洲人材养成研究中心所长、上智大学吴哥窟遗迹国际调查团团长，也曾担任文化厅文化审议会会长。",
      "type": "paragraph",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 2,
      "text": "生平",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 3,
      "text": "学历",
      "type": "heading",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 4,
      "text": "* 北海道带广市出身。",
      "type": "list-item",
      "level": 3,
      "parent_id": 3
    },
    {
      "unit_id": 5,
      "text": "* 1957年、北海道带广三条高等学校毕业",
      "type": "list-item",
      "level": 3,
      "parent_id": 3
    },
    {
      "unit_id": 6,
      "text": "* 1961年、上智大学外国语学部法语学科毕业",
      "type": "list-item",
      "level": 3,
      "parent_id": 3
    },
    {
      "unit_id": 7,
      "text": "* 1968年、中央大学大学院文学研究科东洋史専攻修士课程修了",
      "type": "list-item",
      "level": 3,
      "parent_id": 3
    },
    {
      "unit_id": 8,
      "text": "* 1971年、同大学院文学研究科东洋史専攻博士课程满期退学",
      "type": "list-item",
      "level": 3,
      "parent_id": 3
    },
    {
      "unit_id": 9,
      "text": "* 1977年　取得中央大学文学博士。论文是「古代カンボジア史研究 -Preangkor期の政治と社会-」",
      "type": "list-item",
      "level": 3,
      "parent_id": 3
    },
    {
      "unit_id": 10,
      "text": "职歴",
      "type": "heading",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 11,
      "text": "* 1961年、柬埔寨Conservation des Monuments d'Angkor 研究员",
      "type": "list-item",
      "level": 3,
      "parent_id": 10
    },
    {
      "unit_id": 12,
      "text": "* 1971年、圣玛丽安娜医科大学医学进学课程専任讲师",
      "type": "list-item",
      "level": 3,
      "parent_id": 10
    },
    {
      "unit_id": 13,
      "text": "* 1974年、圣玛丽安娜医科大学助教授",
      "type": "list-item",
      "level": 3,
      "parent_id": 10
    },
    {
      "unit_id": 14,
      "text": "* 1977年、鹿儿岛大学助教授",
      "type": "list-item",
      "level": 3,
      "parent_id": 10
    },
    {
      "unit_id": 15,
      "text": "* 1980年、鹿儿岛大学教授",
      "type": "list-item",
      "level": 3,
      "parent_id": 10
    },
    {
      "unit_id": 16,
      "text": "* 1982年、上智大学教授",
      "type": "list-item",
      "level": 3,
      "parent_id": 10
    },
    {
      "unit_id": 17,
      "text": "* 1997年、上智大学外国语学部长",
      "type": "list-item",
      "level": 3,
      "parent_id": 10
    },
    {
      "unit_id": 18,
      "text": "* 2002年、上智大学亚洲人材养成研究中心兼务",
      "type": "list-item",
      "level": 3,
      "parent_id": 10
    },
    {
      "unit_id": 19,
      "text": "* 2005年4月1日、第13代上智大学学长就任",
      "type": "list-item",
      "level": 3,
      "parent_id": 10
    },
    {
      "unit_id": 20,
      "text": "* 2007年、文化庁文化审议会会长",
      "type": "list-item",
      "level": 3,
      "parent_id": 10
    },
    {
      "unit_id": 21,
      "text": "* 2011年4月1日、上智大学特任教授采用（就任）",
      "type": "list-item",
      "level": 3,
      "parent_id": 10
    },
    {
      "unit_id": 22,
      "text": "※以上、「上智大学教员教育研究情报データベース」の个人プロフィールより",
      "type": "paragraph",
      "level": 3,
      "parent_id": 10
    },
    {
      "unit_id": 23,
      "text": "获奖经歴",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 24,
      "text": "* 1991年　外务大臣表彰",
      "type": "list-item",
      "level": 2,
      "parent_id": 23
    },
    {
      "unit_id": 25,
      "text": "* 1998年　柬埔寨王国的施汉诺国王银杯受奖",
      "type": "list-item",
      "level": 2,
      "parent_id": 23
    },
    {
      "unit_id": 26,
      "text": "* 1998年　柬埔寨王国施汉诺国王から「サハメトリ章」亲授",
      "type": "list-item",
      "level": 2,
      "parent_id": 23
    },
    {
      "unit_id": 27,
      "text": "* 2003年　国际交流基金奖",
      "type": "list-item",
      "level": 2,
      "parent_id": 23
    },
    {
      "unit_id": 28,
      "text": "* 2012年　瑞宝重光章",
      "type": "list-item",
      "level": 2,
      "parent_id": 23
    },
    {
      "unit_id": 29,
      "text": "* 2017年　拉蒙·麦格塞塞奖",
      "type": "list-item",
      "level": 2,
      "parent_id": 23
    },

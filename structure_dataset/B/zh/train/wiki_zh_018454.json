    },
    {
      "unit_id": 30,
      "text": "比赛时间：3小时48分",
      "type": "list-item",
      "level": 3,
      "parent_id": 23
    },
    {
      "unit_id": 31,
      "text": "观众人数：10772人",
      "type": "list-item",

{
  "doc_id": "doc_001",
  "doc_name": "廿日市市",
  "language": "zh",
  "units": [
    {
      "unit_id": 0,
      "text": "廿日市市为位于广岛县西部的市，辖区北部是中国山地，此地所输出的木材运往位于辖区南部沿海的港口，使此地成为西日本主要的木材港，也带动周边与木材相关的营建、修缮、家具等产业。\n日本三景之一、世界遗产严岛神社所在地宫岛，即位于该市境内。\n城市名称「廿日市」源自现在的市中心地区在镰仓时代固定在毎月的20日举办市集。",
      "type": "title",
      "level": 0,
      "parent_id": null
    },
    {
      "unit_id": 1,
      "text": "人口",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 2,
      "text": "历史",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 3,
      "text": "沿革",
      "type": "heading",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 4,
      "text": "* 1889年4月1日：实施町村制，现在的辖区在当时分属：佐伯郡廿日市町、平良村、原村、宫内村、地御前村、玖岛村、三和村、友原村、津田村、浅原村、四和村、吉和村、大野村、严岛町。",
      "type": "list-item",
      "level": 3,
      "parent_id": 3
    },
    {
      "unit_id": 5,
      "text": "* 1929年4月1日：",
      "type": "list-item",
      "level": 3,
      "parent_id": 3
    },
    {
      "unit_id": 6,
      "text": " * 三和村和友原村合并为友和村。",
      "type": "list-item",
      "level": 4,
      "parent_id": 5
    },
    {
      "unit_id": 7,
      "text": " * 津田村改制为津田町。",
      "type": "list-item",
      "level": 4,
      "parent_id": 5
    },
    {
      "unit_id": 8,
      "text": "* 1950年4月1日：大野村改制为大野町。",
      "type": "list-item",
      "level": 3,
      "parent_id": 3
    },
    {
      "unit_id": 9,
      "text": "* 1950年11月3日：严岛町改名为宫岛町。",
      "type": "list-item",
      "level": 3,
      "parent_id": 3
    },
    {
      "unit_id": 10,
      "text": "* 1955年4月1日：津田町、友和村、玖岛村、浅原村、四和村合并为佐伯町。",
      "type": "list-item",
      "level": 3,
      "parent_id": 3
    },
    {
      "unit_id": 11,
      "text": "* 1956年9月30日：廿日市町和平良村、原村、宫内村、地御前村合并为新设置的廿日市町。",
      "type": "list-item",
      "level": 3,
      "parent_id": 3
    },
    {
      "unit_id": 12,
      "text": "* 1957年6月10日：五日市町（现已并入广岛市）的佐方地区被并入廿日市町。",
      "type": "list-item",
      "level": 3,
      "parent_id": 3
    },
    {
      "unit_id": 13,
      "text": "* 1988年4月1日　廿日市町改制为廿日市市。",
      "type": "list-item",
      "level": 3,
      "parent_id": 3
    },
    {
      "unit_id": 14,
      "text": "* 2003年3月1日：佐伯町和吉和村并入廿日市市。",
      "type": "list-item",
      "level": 3,
      "parent_id": 3
    },
    {
      "unit_id": 15,
      "text": "* 2005年11月3日：大野町和宫岛町并入廿日市市。",
      "type": "list-item",
      "level": 3,
      "parent_id": 3
    },

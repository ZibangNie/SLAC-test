      "type": "paragraph",
      "level": 2,
      "parent_id": 70
    },
    {
      "unit_id": 72,
      "text": "素人登场",
      "type": "heading",
      "level": 2,
      "parent_id": 70
    },
    {
      "unit_id": 73,
      "text": "本期共迎来四组素人挑战者，四组皆成功登上主舞台。",
      "type": "paragraph",
      "level": 3,
      "parent_id": 72
    },
    {

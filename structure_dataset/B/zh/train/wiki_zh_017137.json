{
  "doc_id": "doc_001",
  "doc_name": "圣公会牧爱小学（S.K.H. Good Shepherd Primary School）",
  "language": "zh",
  "units": [
    {
      "unit_id": 0,
      "text": "圣公会牧爱小学（S.K.H. Good Shepherd Primary School）是香港一所津贴全日制男女小学，为圣公会牧爱堂主办，创校于1963年。现任校长为梁浩伟先生，校监为梁丽娥女士。",
      "type": "title",
      "level": 0,
      "parent_id": null
    },
    {

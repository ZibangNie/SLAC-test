      "text": "奉节县",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 50,
      "text": "巫山县",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 51,
      "text": "巫溪县",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 52,
      "text": "石柱土家族自治县",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 53,
      "text": "秀山土家族苗族自治县",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 54,
      "text": "酉阳土家族自治县",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 55,
      "text": "彭水苗族土家族自治县",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 56,
      "text": "城际线路",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 57,
      "text": "往来以上区县与中心城区线路",
      "type": "heading",
      "level": 2,
      "parent_id": 56
    },
    {
      "unit_id": 58,
      "text": "以上区县之间的跨区（县）线路",
      "type": "heading",

      "level": 2,
      "parent_id": 5
    },
    {
      "unit_id": 8,
      "text": "* 人伦部：人间、家族",
      "type": "list-item",
      "level": 2,
      "parent_id": 5
    },
    {
      "unit_id": 9,
      "text": "* 形体部：身体各部",
      "type": "list-item",
      "level": 2,
      "parent_id": 5
    },
    {
      "unit_id": 10,
      "text": "* 疾病部：病气",
      "type": "list-item",
      "level": 2,
      "parent_id": 5

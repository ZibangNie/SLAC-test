  "doc_name": "甲斐国",
  "language": "zh",
  "units": [
    {
      "unit_id": 0,
      "text": "甲斐国，是日本古代的令制国之一，属东海道，亦称为甲州（こうしゅう）。其位置相当于现代日本行政区中的山梨县。",
      "type": "title",
      "level": 0,
      "parent_id": null
    },

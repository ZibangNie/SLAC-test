{
  "doc_id": "doc_001",
  "doc_name": "Team NII 6th Stage「专属派对」公演是SNH48的剧场公演",
  "language": "zh",
  "units": [
    {
      "unit_id": 0,
      "text": "Team NII 6th Stage「专属派对」公演是SNH48的剧场公演，此套公演同时也是SNH48 Team NII的首套原创公演。",
      "type": "title",
      "level": 0,
      "parent_id": null
    },
    {
      "unit_id": 1,
      "text": "概要",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 2,
      "text": "《专属派对》是SNH48制作团队为Team NII量身打造的一套全新原创公演，制作团队进行了大胆的尝试与突破，为多样的音乐曲风搭配丰富的服装、道具与舞美设计，并根据整场公演的故事线索制作出每一首独具个性的歌曲，16首歌曲紧扣「派对」主题进行演绎。",
      "type": "paragraph",
      "level": 2,
      "parent_id": 1
    },
    {

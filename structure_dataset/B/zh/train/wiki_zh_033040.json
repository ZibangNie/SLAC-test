{
  "doc_id": "doc_001",
  "doc_name": "日光线 (东武铁道)",
  "language": "zh",
  "units": [
    {
      "unit_id": 0,
      "text": "日光线 (东武铁道)",
      "type": "title",
      "level": 0,
      "parent_id": null
    },
    {
      "unit_id": 1,
      "text": "日光线连结日本埼玉县南埼玉郡宫代町东武动物公园站和栃木县日光市东武日光站，是属于东武铁道的铁路线。路线颜色为橙色，车站编号的路线记号为TN。",
      "type": "paragraph",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 2,
      "text": "路线资料",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 3,
      "text": "* 路线距离：94.5公里",
      "type": "list-item",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 4,
      "text": "* 轨距：1067毫米",
      "type": "list-item",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 5,
      "text": "* 复线路段：全线复线",
      "type": "list-item",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 6,
      "text": "* 电气化路段：全线电气化（直流1500V）",
      "type": "list-item",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 7,
      "text": "* 站数：26（包括起终点站）",
      "type": "list-item",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 8,
      "text": "* 闭塞方式：自动闭塞式",
      "type": "list-item",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 9,
      "text": "* 保安装置：东武型ATS",
      "type": "list-item",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 10,
      "text": "* 最高速度：120公里/小时（100系、JR东日本253系使用的特急）",
      "type": "list-item",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 11,
      "text": "* 最长编组与月台长度（所有均为20米车）",
      "type": "list-item",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 12,
      "text": " * 东武动物公园－南栗桥各站：10辆",
      "type": "list-item",
      "level": 3,
      "parent_id": 11
    },
    {
      "unit_id": 13,
      "text": " * 栗桥－下今市各站、东武日光站：6辆",
      "type": "list-item",
      "level": 3,
      "parent_id": 11
    },
    {
      "unit_id": 14,
      "text": " * 上今市站：4辆",
      "type": "list-item",
      "level": 3,
      "parent_id": 11
    },
    {
      "unit_id": 15,
      "text": "沿革",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 16,
      "text": "年表",
      "type": "heading",
      "level": 2,
      "parent_id": 15
    },
    {
      "unit_id": 17,
      "text": "* 1929年（昭和4年）4月1日 杉户 - 新鹿沼间开业。",
      "type": "list-item",
      "level": 3,
      "parent_id": 16
    },
    {
      "unit_id": 18,
      "text": "* 1929年（昭和4年）7月1日 东武和泉站改名静和站。",
      "type": "list-item",
      "level": 3,
      "parent_id": 16
    },
    {
      "unit_id": 19,
      "text": "* 1929年（昭和4年）7月7日 新鹿沼 - 下今市间开业。",
      "type": "list-item",
      "level": 3,
      "parent_id": 16
    },
    {
      "unit_id": 20,
      "text": "* 1929年（昭和4年）10月1日 下今市 - 东武日光间开业。",
      "type": "list-item",
      "level": 3,
      "parent_id": 16
    },
    {
      "unit_id": 21,
      "text": "* 1929年（昭和4年）11月1日 明神站开业。",
      "type": "list-item",
      "level": 3,
      "parent_id": 16
    },
    {
      "unit_id": 22,
      "text": "* 1931年（昭和6年）11月1日 新大平下站开业。",
      "type": "list-item",
      "level": 3,
      "parent_id": 16
    },
    {
      "unit_id": 23,
      "text": "* 1931年（昭和6年）12月10日 北鹿沼站开业。",
      "type": "list-item",
      "level": 3,
      "parent_id": 16
    },
    {
      "unit_id": 24,
      "text": "* 1935年（昭和10年）7月21日 新古河站开业。此新古河站其后改名新古河荷扱所。",
      "type": "list-item",
      "level": 3,
      "parent_id": 16
    },
    {
      "unit_id": 25,
      "text": "* 1943年（昭和18年）1月19日 - 1945年（昭和20年）6月21日 合战场以北单线化。",
      "type": "list-item",
      "level": 3,
      "parent_id": 16
    },
    {
      "unit_id": 26,
      "text": "* 1945年（昭和20年）8月8日 上今市 - 东武日光间的东武野口站开业。同月中废止。",
      "type": "list-item",
      "level": 3,
      "parent_id": 16
    },
    {
      "unit_id": 27,
      "text": "* 1955年（昭和30年）9月15日 下今市 - 东武日光间恢复为复线。",
      "type": "list-item",
      "level": 3,
      "parent_id": 16
    },
    {
      "unit_id": 28,
      "text": "* 1956年（昭和31年）3月24日 明神 - 下今市间恢复为复线。",
      "type": "list-item",
      "level": 3,
      "parent_id": 16
    },
    {
      "unit_id": 29,
      "text": "* 1958年（昭和33年） 使用5310系和3210系的观光用「准快速」列车开始。「准快速」列车名称其后在改用6000系时统一为「快速」。",
      "type": "list-item",
      "level": 3,
      "parent_id": 16
    },
    {
      "unit_id": 30,
      "text": "* 1963年（昭和38年）6月22日 下小代 - 明神间恢复为复线。",
      "type": "list-item",
      "level": 3,
      "parent_id": 16
    },
    {
      "unit_id": 31,
      "text": "* 1963年（昭和38年）9月21日 板荷 - 下小代间恢复为复线。",
      "type": "list-item",
      "level": 3,
      "parent_id": 16
    },
    {
      "unit_id": 32,
      "text": "* 1964年（昭和39年）3月1日 快速専用车辆开始改用6000系。",
      "type": "list-item",
      "level": 3,
      "parent_id": 16
    },
    {
      "unit_id": 33,
      "text": "* 1964年（昭和39年）5月1日 北鹿沼 - 板荷间恢复为复线。",
      "type": "list-item",
      "level": 3,
      "parent_id": 16
    },
    {
      "unit_id": 34,
      "text": "* 1964年（昭和39年）5月31日 座席指定席的快速列车在部份车辆导入。",
      "type": "list-item",
      "level": 3,
      "parent_id": 16
    },
    {
      "unit_id": 35,
      "text": "* 1965年（昭和40年）9月18日 新鹿沼 - 北鹿沼间恢复为复线。",
      "type": "list-item",
      "level": 3,
      "parent_id": 16
    },
    {
      "unit_id": 36,
      "text": "* 1969年（昭和44年）5月1日 栗桥 - 新古河间的新古河荷扱所废止成新古河信号所。",
      "type": "list-item",
      "level": 3,
      "parent_id": 16
    },
    {
      "unit_id": 37,
      "text": "* 1973年（昭和48年）7月20日 合战场 - 新鹿沼间恢复为复线。此时全线皆恢复为复线。",
      "type": "list-item",
      "level": 3,
      "parent_id": 16
    },
    {
      "unit_id": 38,
      "text": "* 1976年（昭和51年） 快速列车的座席指定席废止。",
      "type": "list-item",
      "level": 3,
      "parent_id": 16
    },
    {
      "unit_id": 39,
      "text": "* 1981年（昭和56年）3月16日 杉户站改名东武动物公园站。",
      "type": "list-item",
      "level": 3,
      "parent_id": 16
    },
    {
      "unit_id": 40,
      "text": "* 1981年（昭和56年）9月15日 栗桥 - 新古河间的新古河信号所废止。",
      "type": "list-item",
      "level": 3,
      "parent_id": 16
    },
    {
      "unit_id": 41,
      "text": "* 1985年（昭和60年）11月15日 快速列车的6000系车辆开始更新成6050系。",
      "type": "list-item",
      "level": 3,
      "parent_id": 16
    },
    {
      "unit_id": 42,
      "text": "* 1986年（昭和61年）8月26日 杉户高野台站、南栗桥站开业。",
      "type": "list-item",
      "level": 3,
      "parent_id": 16
    },
    {
      "unit_id": 43,
      "text": "* 1986年（昭和61年）10月9日 野岩铁道会津鬼怒川线开业、快速列车的运行区间延长至同线会津高原站（现会津高原尾濑口站）。",
      "type": "list-item",
      "level": 3,
      "parent_id": 16
    },
    {
      "unit_id": 44,
      "text": "* 1990年（平成2年）10月12日 会津铁道会津线会津高原站 - 会津田岛站间电气化、快速列车的运行区间扩大至会津田岛站。",
      "type": "list-item",
      "level": 3,
      "parent_id": 16
    },
    {
      "unit_id": 45,
      "text": "* 1997年（平成9年）3月25日 板仓东洋大前站开业。",
      "type": "list-item",
      "level": 3,
      "parent_id": 16
    },
    {
      "unit_id": 46,
      "text": "* 2000年（平成12年）5月11日 栃木站高架化。",
      "type": "list-item",
      "level": 3,
      "parent_id": 16
    },
    {
      "unit_id": 47,
      "text": "* 2003年（平成15年）3月19日 营团地下铁（现东京地下铁）经由半藏门线至东急田园都市线中央林间 - 南栗桥间直通的通勤准急・区间准急（现:急行・准急）运行开始。",
      "type": "list-item",
      "level": 3,
      "parent_id": 16
    },
    {
      "unit_id": 48,
      "text": "* 2006年（平成18年）3月18日 栗桥站构内设置JR宇都宫线（东北本线）的连络线、至JR新宿 - 东武日光・鬼怒川温泉间的直通特急列车开始运行。",
      "type": "list-item",
      "level": 3,
      "parent_id": 16
    },
    {
      "unit_id": 49,
      "text": "* 2006年（平成18年）12月16日 5050系在新栃木 - 东武日光间进行告别车班的行驶活动。",
      "type": "list-item",
      "level": 3,
      "parent_id": 16
    },
    {
      "unit_id": 50,
      "text": "* 2007年（平成19年）11月1日 栃木 - 新栃木间由栃木站发着的宇都宫线直通列车实施单人运行。",
      "type": "list-item",
      "level": 3,
      "parent_id": 16
    },
    {
      "unit_id": 51,
      "text": "* 2019年（令和元年）10月12日 受强烈台风哈吉贝（台风19号）的影响，日光线多处路段因道碴流失及路堤崩坏而受损停驶。",
      "type": "list-item",
      "level": 3,
      "parent_id": 16
    },
    {
      "unit_id": 52,
      "text": "车站列表",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 53,
      "text": "* 特急、急行、区间急行以外的列车类别停靠所有车站，因此省略。特急列车参见「华严」、「鬼怒」、「雾降」、「下野」、快速「会津山岳特快」参见列车条目。准急、区间准急只限东武动物公园－南栗桥运行。",
      "type": "list-item",
      "level": 2,
      "parent_id": 52
    },
    {
      "unit_id": 54,
      "text": "留置线车站",
      "type": "heading",
      "level": 2,
      "parent_id": 52
    },
    {
      "unit_id": 55,
      "text": "* 南栗桥站（南栗桥车辆管理区并设。半藏门线直通列车于本站终着）",
      "type": "list-item",
      "level": 3,
      "parent_id": 54
    },
    {
      "unit_id": 56,
      "text": "* 栃木站（春日部方有留置线。日光线・宇都宫线列车向新栃木方面折返使用）",
      "type": "list-item",
      "level": 3,
      "parent_id": 54
    },
    {
      "unit_id": 57,
      "text": "* 新栃木站（南栗桥车辆管理区新栃木出张所并设。南栗桥工场出场车的试运行折返使用）",
      "type": "list-item",
      "level": 3,
      "parent_id": 54
    },
    {
      "unit_id": 58,
      "text": "* 下今市站",
      "type": "list-item",
      "level": 3,
      "parent_id": 54
    },
    {
      "unit_id": 59,
      "text": "废站",
      "type": "heading",
      "level": 2,
      "parent_id": 52
    },
    {
      "unit_id": 60,
      "text": "* 新古河荷扱所（（旧）新古河站）",
      "type": "list-item",
      "level": 3,
      "parent_id": 59
    },
    {
      "unit_id": 61,
      "text": " * 栗桥 - 新古河间 1929年4月1日、旅客站「新古河站」开业。1935年7月21日、新「新古河」站开业荷扱所化、1969年5月1日信号所化、1981年9月15日废止。",
      "type": "list-item",
      "level": 4,
      "parent_id": 60
    },
    {
      "unit_id": 62,
      "text": "* 东武野口站",
      "type": "list-item",
      "level": 3,
      "parent_id": 59
    },
    {
      "unit_id": 63,
      "text": " * 上今市 - 东武日光间 1945年8月8日开业、同月废止。",
      "type": "list-item",
      "level": 4,
      "parent_id": 62
    },
    {
      "unit_id": 64,
      "text": "过去的连接路线",
      "type": "heading",
      "level": 2,
      "parent_id": 52
    },
    {
      "unit_id": 65,
      "text": "* 东武日光站：东武日光轨道线",
      "type": "list-item",
      "level": 3,
      "parent_id": 64
    },
    {
      "unit_id": 66,
      "text": "关连项目",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 67,
      "text": "* 日本铁路线列表",
      "type": "list-item",
      "level": 2,
      "parent_id": 66
    }
  ]
}
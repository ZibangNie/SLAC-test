  "units": [
    {
      "unit_id": 0,
      "text": "德意志邦联成员邦国",
      "type": "title",
      "level": 0,
      "parent_id": null
    },
    {
      "unit_id": 1,
      "text": "德意志邦联的邦国于1815年6月20日加入这一组织，一直到1866年8月24日邦联解体期间的所有成员国的变化。总的来说，德意志邦联的范围基本与法国大革命爆发时神圣罗马帝国的领土一致，但比较明显的一部分就是排除了瑞士、比利时、荷兰、北意大利这些不再以德意志为民族认同的地区。邦联主要可以被分以下几部分：奥地利帝国、普鲁士王国、法国曾经占领的莱茵河西岸地区以及前莱茵邦联的全部成员国。",
      "type": "paragraph",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 2,
      "text": "成员国",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 3,
      "text": "帝国",
      "type": "heading",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 4,
      "text": "* 奥地利帝国，不包括匈牙利王国、特兰西瓦尼亚公国和克罗地亚-斯拉沃尼亚王国（所有这些都在多瑙河双君主制下成为匈牙利王国的一部分），伦巴第-威尼斯王国（1859割让给意大利）、布科维纳公国以及达尔马提亚和加利西亚王国。",
      "type": "list-item",
      "level": 3,
      "parent_id": 3
    },
    {
      "unit_id": 5,
      "text": "* # 奥地利大公国（1849 年分裂为上奥地利和下奥地利）",
      "type": "list-item",
      "level": 3,
      "parent_id": 3
    },
    {
      "unit_id": 6,
      "text": "* # 波西米亚王国",
      "type": "list-item",
      "level": 3,
      "parent_id": 3
    },
    {
      "unit_id": 7,
      "text": "* # 摩拉维亚侯国",
      "type": "list-item",
      "level": 3,
      "parent_id": 3

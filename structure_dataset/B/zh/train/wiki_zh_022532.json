  "units": [
    {
      "unit_id": 0,
      "text": "龙星战 (中国)",
      "type": "title",
      "level": 0,
      "parent_id": null
    },
    {
      "unit_id": 1,
      "text": "四维数创杯中国龙星战（原钻石杯）是中国的围棋比赛。2004年创设。主办单位是中国围棋协会，协办单位是日本SCJ株式会社围棋将棋频道，河北中烟工业有限责任公司赞助。比赛用时为每手棋30秒，10次1分钟自由支配时间。冠亚军奖金分别为人民币8万元和3万元，第三届提高到人民币12万元和5万元。",
      "type": "paragraph",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 2,
      "text": "赛制",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 3,
      "text": "采用最新中国围棋竞赛规则，本选赛及本赛用时为：每步棋30秒，每方有10次1分钟自由时间。",
      "type": "paragraph",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 4,
      "text": "决胜战以三战决胜负。",
      "type": "paragraph",
      "level": 2,
      "parent_id": 2
    },
    {

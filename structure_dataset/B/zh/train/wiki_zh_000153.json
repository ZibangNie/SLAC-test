  "units": [
    {
      "unit_id": 0,
      "text": "大学预科 (日本)",
      "type": "title",
      "level": 0,
      "parent_id": null
    },
    {
      "unit_id": 1,
      "text": "大学预科是日本依据大学令（1918年公布、1919年4月1日施行）或各帝国大学官制设置，至1955年存在的高等教育机关。",
      "type": "paragraph",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 2,
      "text": "一览",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 3,
      "text": "依第一次高等学校令等设置",
      "type": "heading",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 4,
      "text": "旧制高等学校大学预科（3年制）",
      "type": "heading",
      "level": 3,
      "parent_id": 3
    },
    {
      "unit_id": 5,
      "text": "* 第一・二・四・五・山口5校在1894年（明治27年）改组前身的高等中学校本科（2年制），设置大学预科（3年制）。",
      "type": "list-item",
      "level": 4,
      "parent_id": 4
    },
    {
      "unit_id": 6,
      "text": "第一高等学校大学预科（东京大学教养学部）",

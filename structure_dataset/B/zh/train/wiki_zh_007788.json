    {
      "unit_id": 0,
      "text": "上京区",
      "type": "title",
      "level": 0,
      "parent_id": null
    },
    {
      "unit_id": 1,
      "text": "上京区是京都市11区之一，位于京都市中心的北部。鸭川从其东侧通过，京都府厅也设于此区之内。",
      "type": "paragraph",
      "level": 1,
      "parent_id": 0
    },

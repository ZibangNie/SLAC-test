      "parent_id": 12
    },
    {
      "unit_id": 29,
      "text": "* 场务：孔庆祥",
      "type": "list-item",
      "level": 2,
      "parent_id": 12
    },
    {
      "unit_id": 30,
      "text": "* 场记：金军",
      "type": "list-item",
      "level": 2,
      "parent_id": 12
    },
    {
      "unit_id": 31,
      "text": "* 照像：周诗清",
      "type": "list-item",
      "level": 2,
      "parent_id": 12
    },
    {
      "unit_id": 32,
      "text": "* 测光：刘易士",
      "type": "list-item",
      "level": 2,
      "parent_id": 12
    },
    {
      "unit_id": 33,
      "text": "歌曲配唱",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 34,
      "text": "* 静婷 配 貂蝉",
      "type": "list-item",
      "level": 2,
      "parent_id": 33
    },
    {
      "unit_id": 35,
      "text": "* 鲍方 配 吕布",
      "type": "list-item",
      "level": 2,
      "parent_id": 33
    },
    {
      "unit_id": 36,
      "text": "* 杨志卿 配 王允",
      "type": "list-item",
      "level": 2,
      "parent_id": 33
    },
    {
      "unit_id": 37,
      "text": "* ？ 配 董卓",
      "type": "list-item",
      "level": 2,
      "parent_id": 33
    },
    {
      "unit_id": 38,
      "text": "剧情",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 39,
      "text": "郊道哭亲",
      "type": "heading",
      "level": 2,
      "parent_id": 38
    },
    {
      "unit_id": 40,
      "text": "汉献帝初平元年（公元190年），奸臣董卓为避讨董各路大军，挟帝迁都长安，百姓不肯随行，董乃举火将洛阳付之一炬，百姓扶老携幼，仓皇就道，哭声遍野。",
      "type": "paragraph",
      "level": 3,
      "parent_id": 39
    },
    {
      "unit_id": 41,
      "text": "* 万刼哀鸿（汉朝末代乱纷纷）：老子亲唱",
      "type": "list-item",
      "level": 3,
      "parent_id": 39
    },
    {
      "unit_id": 42,
      "text": "貂蝉父母在途中身亡，貂蝉伏尸哭拜，声泪俱下。",
      "type": "paragraph",
      "level": 3,
      "parent_id": 39
    },
    {
      "unit_id": 43,
      "text": "* 哭亲（貂蝉哭倒路途旁）：貂蝉（作曲：王纯；作词：李隽青；幕后代唱：静婷）",
      "type": "list-item",
      "level": 3,
      "parent_id": 39
    },
    {
      "unit_id": 44,
      "text": "席间杀温",
      "type": "heading",
      "level": 2,
      "parent_id": 38
    },
    {
      "unit_id": 45,
      "text": "貂蝉独至长安入司徒王允府为婢女。袁术下书与张温将军密谋，不料书信错投董卓义子吕布府，吕布连忙将此事报告正在郿坞私邸行营大宴百官的董卓，张温当即被杀，人头献上，在座诸臣个个心惊。",
      "type": "paragraph",
      "level": 3,
      "parent_id": 44
    },
    {
      "unit_id": 46,
      "text": "拜月定计",
      "type": "heading",
      "level": 2,
      "parent_id": 38
    },
    {
      "unit_id": 47,
      "text": "王允回府后愁眉不展。",
      "type": "paragraph",
      "level": 3,
      "parent_id": 46
    },
    {
      "unit_id": 48,
      "text": "* 长安曲（群臣敢怒不敢言）：女声合唱",
      "type": "list-item",
      "level": 3,
      "parent_id": 46
    },
    {
      "unit_id": 49,
      "text": "貂蝉心知大势难挽，奸贼难除，又想到诸侯兴兵，黄巾作乱，忧国忧民，不禁对月祈祷。",
      "type": "paragraph",
      "level": 3,
      "parent_id": 46
    },
    {
      "unit_id": 50,
      "text": "* 拜月（莫不是大势难回转）：貂蝉（作曲：王纯  作词：李隽青 幕后代唱：静婷）",
      "type": "list-item",
      "level": 3,
      "parent_id": 46
    },
    {
      "unit_id": 51,
      "text": "谁知王允听到了貂蝉之祷词，心生一计，便向貂蝉下拜，貂蝉答应依计除掉董卓和吕布。",
      "type": "paragraph",
      "level": 3,
      "parent_id": 46
    },
    {
      "unit_id": 52,
      "text": "* 密室定计（董卓专权害百姓）：王允-貂蝉",
      "type": "list-item",
      "level": 3,
      "parent_id": 46
    },
    {
      "unit_id": 53,
      "text": "赠冠初会",
      "type": "heading",
      "level": 2,
      "parent_id": 38
    },
    {
      "unit_id": 54,
      "text": "吕布在虎牢関三英战吕布时失落金冠，十分懊恼。王允不惜家珍，以珠宝打造金冠一顶，赠与吕布。",
      "type": "paragraph",
      "level": 3,
      "parent_id": 53
    },
    {
      "unit_id": 55,
      "text": "* 赠冠（司徒心中早分明）：女声合唱",
      "type": "list-item",
      "level": 3,
      "parent_id": 53
    },
    {
      "unit_id": 56,
      "text": "吕布手捧金冠大喜过望，决定过府回拜王允。",
      "type": "paragraph",
      "level": 3,
      "parent_id": 53
    },
    {
      "unit_id": 57,
      "text": "* 受冠（手捧金冠细观看）：吕布",
      "type": "list-item",
      "level": 3,
      "parent_id": 53
    },
    {
      "unit_id": 58,
      "text": "吕布与貂蝉在王允府一见钟情。王允顺水推舟，答应将貂蝉嫁与吕布。貂蝉内心对吕布十分矛盾。",
      "type": "paragraph",
      "level": 3,
      "parent_id": 53
    },
    {
      "unit_id": 59,
      "text": "* 雄心难测（又威武又多情）：貂蝉",
      "type": "list-item",
      "level": 3,
      "parent_id": 53
    },
    {
      "unit_id": 60,
      "text": "大宴别蝉",
      "type": "heading",
      "level": 2,
      "parent_id": 38
    },
    {
      "unit_id": 61,
      "text": "王允在府设宴，请董卓观舞。貂蝉舞姿婆娑，令董卓垂涎三尺。王允便将貂蝉送与董卓。",
      "type": "paragraph",
      "level": 3,
      "parent_id": 60
    },
    {
      "unit_id": 62,
      "text": "* 大宴歌舞（一人下，万人上，并肩天子令侯王）：女声合唱",
      "type": "list-item",
      "level": 3,
      "parent_id": 60
    },
    {
      "unit_id": 63,
      "text": "王允在府门外看著貂蝉乘辇随董卓而去，不禁悲喜交加。",
      "type": "paragraph",
      "level": 3,
      "parent_id": 60
    },
    {
      "unit_id": 64,
      "text": "* ？（司徒忍泪别貂蝉）：女声合唱",
      "type": "list-item",
      "level": 3,
      "parent_id": 60
    },
    {
      "unit_id": 65,
      "text": "后堂寻蝉",
      "type": "heading",
      "level": 2,
      "parent_id": 38
    },
    {
      "unit_id": 66,
      "text": "* ？（香车载美入朱门）：女声合唱",
      "type": "list-item",
      "level": 3,
      "parent_id": 65
    },
    {
      "unit_id": 67,
      "text": "吕布闻听貂蝉被王允送给董卓，怒气冲冲直闯王允府兴师问罪。王允却说是董卓为吕布将新妇接回。吕布到太师府，得知貂蝉成了董卓的如夫人，又惊又怒。",
      "type": "paragraph",
      "level": 3,
      "parent_id": 65
    },
    {
      "unit_id": 68,
      "text": "* ？（貂蝉两字刺心尖）：女声合唱",
      "type": "list-item",
      "level": 3,
      "parent_id": 65
    },
    {
      "unit_id": 69,
      "text": "吕布来至太师府后堂寻貂蝉，却被董卓逐出。自此对董卓心怀怨恨。",
      "type": "paragraph",
      "level": 3,
      "parent_id": 65
    },
    {
      "unit_id": 70,
      "text": "* ？（一个是咬牙切齿频看剑，频看剑）：女声合唱",
      "type": "list-item",
      "level": 3,
      "parent_id": 65
    },
    {
      "unit_id": 71,
      "text": "董卓女婿李儒向董卓献计，多赐吕布金帛以安其心。",
      "type": "paragraph",
      "level": 3,
      "parent_id": 65
    },
    {
      "unit_id": 72,
      "text": "凤仪亭变",
      "type": "heading",
      "level": 2,
      "parent_id": 38
    },
    {
      "unit_id": 73,
      "text": "吕布随董卓出行，趁机溜回太师府与貂蝉相会。",
      "type": "paragraph",
      "level": 3,
      "parent_id": 72
    },
    {
      "unit_id": 74,
      "text": "* ？（美人蚀骨又销魂）：女声合唱",
      "type": "list-item",
      "level": 3,
      "parent_id": 72
    },
    {
      "unit_id": 75,
      "text": "二人相会凤仪亭，细语温存。貂蝉以激将法鼓动吕布反对董卓。",
      "type": "paragraph",
      "level": 3,
      "parent_id": 72
    },
    {
      "unit_id": 76,
      "text": "* 凤仪亭（记得当日把酒敬）：貂蝉",
      "type": "list-item",
      "level": 3,
      "parent_id": 72
    },
    {
      "unit_id": 77,
      "text": "正在此时，董卓回府，见状大怒，掷戟于吕布。吕布逃出太师府。貂蝉对吕布情意绵绵，恩仇难分。",
      "type": "paragraph",
      "level": 3,
      "parent_id": 72
    },
    {
      "unit_id": 78,
      "text": "* 恩仇难分（又豪爽，又温存）：貂蝉（作曲：王纯；作词：李隽青；幕后代唱：静婷）",
      "type": "list-item",
      "level": 3,
      "parent_id": 72
    },
    {
      "unit_id": 79,
      "text": "后堂诉苦",
      "type": "heading",
      "level": 2,
      "parent_id": 38
    },
    {
      "unit_id": 80,
      "text": "李儒劝董卓将貂蝉赐予吕布。貂蝉却向董卓诉苦，令其不从李儒之计。",
      "type": "paragraph",
      "level": 3,
      "parent_id": 79
    },
    {
      "unit_id": 81,
      "text": "* 后堂诉苦（后花园中闲散步）：貂蝉",
      "type": "list-item",
      "level": 3,
      "parent_id": 79
    },
    {
      "unit_id": 82,
      "text": "董卓被貂蝉说动，又决定带貂蝉共赴郿坞。",
      "type": "paragraph",
      "level": 3,
      "parent_id": 79
    },
    {
      "unit_id": 83,
      "text": "* 慰姬（叫声貂蝉休要哭）：董卓",
      "type": "list-item",
      "level": 3,
      "parent_id": 79
    },
    {
      "unit_id": 84,
      "text": "李儒再次劝谏董卓，反受董卓斥骂。貂蝉和董卓启程赴郿坞，吕布在道旁见辇内假装垂泪的貂蝉，心中汹涌不平。",
      "type": "paragraph",
      "level": 3,
      "parent_id": 79
    },
    {
      "unit_id": 85,
      "text": "郿坞相思",
      "type": "heading",
      "level": 2,
      "parent_id": 38
    },
    {
      "unit_id": 86,
      "text": "貂蝉和董卓一路行至郿坞，从此沉醉林园，不问别事。",
      "type": "paragraph",
      "level": 3,
      "parent_id": 85
    },
    {
      "unit_id": 87,
      "text": "* 郿坞风光（清清水，淡淡山）：女声合唱",
      "type": "list-item",
      "level": 3,
      "parent_id": 85
    },
    {
      "unit_id": 88,
      "text": "貂蝉在郿坞私邸中感叹自己命运多舛，思念吕布，难以自己。",
      "type": "paragraph",
      "level": 3,
      "parent_id": 85
    },
    {
      "unit_id": 89,
      "text": "* 郿坞相思（要算那恩仇帐）：貂蝉",
      "type": "list-item",
      "level": 3,
      "parent_id": 85
    },
    {
      "unit_id": 90,
      "text": "吕布重上凤仪亭，睹物思人。",
      "type": "paragraph",
      "level": 3,
      "parent_id": 85
    },
    {
      "unit_id": 91,
      "text": "* 长安相思（凤仪亭还是旧时样）：吕布",
      "type": "list-item",
      "level": 3,
      "parent_id": 85
    },
    {
      "unit_id": 92,
      "text": "二人两地相忆，情深意重。",
      "type": "paragraph",
      "level": 3,
      "parent_id": 85
    },
    {
      "unit_id": 93,
      "text": "* 两地相忆（我爱他英勇今无敌）：貂蝉-吕布",
      "type": "list-item",
      "level": 3,
      "parent_id": 85
    },
    {
      "unit_id": 94,
      "text": "冲冠一怒",
      "type": "heading",
      "level": 2,
      "parent_id": 38
    },
    {
      "unit_id": 95,
      "text": "吕布至王允府计议。王允打消了吕布的顾虑，吕布决意杀董卓，并折矢为誓。",
      "type": "paragraph",
      "level": 3,
      "parent_id": 94
    },
    {
      "unit_id": 96,
      "text": "天子使者至郿坞传诏。董卓闻听天子要禅位于他，心中大喜，连忙回长安。不料半路伏兵四起，李儒等皆被杀。董卓唤吕布救援，却被吕布一戟刺死。",
      "type": "paragraph",
      "level": 3,
      "parent_id": 94
    },
    {
      "unit_id": 97,
      "text": "司徒授计",
      "type": "heading",
      "level": 2,
      "parent_id": 38
    },
    {
      "unit_id": 98,
      "text": "王允见董卓已死，忙赶至郿坞见貂蝉。貂蝉原想大事已成，王允却让她斩草除根，在次日庆功宴时刺死吕布。貂蝉劝说王允收回成命，王允再三不从。",
      "type": "paragraph",
      "level": 3,
      "parent_id": 97
    },
    {
      "unit_id": 99,
      "text": "* 郿坞私邸（既然他除奸心归正）：貂蝉-王允",
      "type": "list-item",
      "level": 3,
      "parent_id": 97
    },
    {
      "unit_id": 100,
      "text": "王允正要向貂蝉授剑，吕布却兴冲冲地赶来见貂蝉。貂蝉劝他急流勇退，吕布不以为意。",
      "type": "paragraph",
      "level": 3,
      "parent_id": 97
    },
    {
      "unit_id": 101,
      "text": "* 雨过天青（笑满脸，喜满心）：吕布-貂蝉",
      "type": "list-item",
      "level": 3,
      "parent_id": 97
    },
    {
      "unit_id": 102,
      "text": "貂蝉眼见次日就要奉命杀死意中人，备受煎熬。",
      "type": "paragraph",
      "level": 3,
      "parent_id": 97
    },
    {
      "unit_id": 103,
      "text": "* 私邸（他那里笑盈盈）：貂蝉",
      "type": "list-item",
      "level": 3,
      "parent_id": 97
    },
    {
      "unit_id": 104,
      "text": "庆功刺布",
      "type": "heading",
      "level": 2,
      "parent_id": 38
    },
    {
      "unit_id": 105,
      "text": "次日，吕布大摆庆功宴。王允提议请貂蝉舞剑助兴。",
      "type": "paragraph",
      "level": 3,
      "parent_id": 104
    },
    {
      "unit_id": 106,
      "text": "* 庆功曲（将军杀贼建奇勋）：众臣",
      "type": "list-item",
      "level": 3,
      "parent_id": 104
    },
    {
      "unit_id": 107,
      "text": "貂蝉执剑起舞，几次欲将手中三尺宝剑刺向吕布，却次次都难以痛下狠手，最后意欲自刎了却此生，幸被吕布救下。王允眼见二人真情难舍，终于松口同意让二人成婚。",
      "type": "paragraph",
      "level": 3,
      "parent_id": 104
    },
    {
      "unit_id": 108,
      "text": "* 落絮恨（我是柳絮沾泥洗难净）：貂蝉-吕布-王允",
      "type": "list-item",
      "level": 3,
      "parent_id": 104
    },
    {
      "unit_id": 109,
      "text": "尾声",
      "type": "heading",
      "level": 2,
      "parent_id": 38
    },
    {
      "unit_id": 110,
      "text": "新婚的吕布和貂蝉离开长安，共赴前程。正所谓“司徒妙计设连环，小说夸张史不传。多少美人关大计，千秋不止一貂蝉。”",
      "type": "paragraph",
      "level": 3,
      "parent_id": 109
    },
    {
      "unit_id": 111,
      "text": "* 连环计（司徒妙计设连环）：女声合唱",
      "type": "list-item",
      "level": 3,
      "parent_id": 109
    }
  ]
}
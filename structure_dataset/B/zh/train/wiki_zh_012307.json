      "text": "* 《文件和证词，1918年》（1968年）",
      "type": "list-item",
      "level": 2,
      "parent_id": 31
    },
    {
      "unit_id": 42,
      "text": "* 《普通社会学。问题，分支，方向》（1968年）",
      "type": "list-item",
      "level": 2,

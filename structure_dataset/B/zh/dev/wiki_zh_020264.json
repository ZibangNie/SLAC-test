{
  "doc_id": "doc_001",
  "doc_name": "草野厚",
  "language": "ja",
  "units": [
    {
      "unit_id": 0,
      "text": "草野厚是一名知名日本政治学者，现任庆应义塾大学综合政策学部名誉教授，专门研究日本外交论、政策过程论、国际関系论、国际协力政策论。",
      "type": "title",
      "level": 0,
      "parent_id": null
    },
    {
      "unit_id": 1,
      "text": "略歴",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 2,
      "text": "* 1947年 东京都出生",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 3,
      "text": "* 1971年 庆应义塾大学法学部法律学科毕业、松下电器贸易入社。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 4,
      "text": "* 1977年 上智大学大学院外国语学研究科修士课程（国际関系论専攻）修了",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 5,
      "text": "* 1981年 东京大学大学院社会学研究科博士课程（国际関系论専攻）修了、社会学博士授与。\n * 著书『日米オレンジ交渉』（1983年）は自身の博士论文に加笔出版。",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 6,
      "text": "* 1983年 国际大学助手（-1985年）",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 7,
      "text": "* 1985年 普林斯顿大学国际问题研究所客员研究员（-1987年）",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 8,
      "text": "* 1987年 东京工业大学助教授（-1992年）",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 9,
      "text": "* 1991年 庆应义塾大学総合政策学部教授 兼 同大学院政策・媒体研究科委员（-2013年3月）",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 10,
      "text": "* 1997年 松下政経塾评议员",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 11,
      "text": "* 2000年 メディア検证机构理事长（-2006年）",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 12,
      "text": "* 2002年 外务省ODA総合戦略会议委员",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 13,
      "text": "* 2007年 国际协力に関する有识者会议委员",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {
      "unit_id": 14,
      "text": "* 2013年 庆应义塾大学名誉教授（2013年4月-）",
      "type": "list-item",
      "level": 2,
      "parent_id": 1
    },
    {

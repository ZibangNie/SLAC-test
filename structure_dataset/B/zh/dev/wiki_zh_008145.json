{
  "doc_id": "doc_001",
  "doc_name": "国道51号 (日本)",
  "language": "zh",
  "units": [
    {
      "unit_id": 0,
      "text": "国道51号 (日本)",
      "type": "title",
      "level": 0,
      "parent_id": null
    },
    {
      "unit_id": 1,
      "text": "国道51号是日本千叶县千叶市至茨城县水户市的一般国道。全线与东关东自动车道水户线并走。",
      "type": "paragraph",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 2,
      "text": "概要",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 3,
      "text": "* 陆上距离：124.0km",
      "type": "list-item",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 4,
      "text": "* 起点：千叶县千叶市（广小路交差点＝国道14号终点、国道126号交点）",
      "type": "list-item",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 5,
      "text": "* 终点：茨城县水户市（三之丸1丁目交点＝国道50号终点、国道118号・国道400号起点）",
      "type": "list-item",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 6,
      "text": "* 主要经由地：千叶县佐仓市、成田市、香取市、茨城县稻敷市、潮来市、鹿嶋市、𫓴田市、大洗町",
      "type": "list-item",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 7,
      "text": "* 指定区间：全线",
      "type": "list-item",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 8,
      "text": "* 车线数:大洗町成田～水户市的东水户道路水户大洗IC与稻敷市内、香取市内合计4车线、𫓴田市内（旧大洋村）为登坂车线上下线1个所设置以外为片侧1车线。",
      "type": "list-item",
      "level": 2,
      "parent_id": 2
    },
    {
      "unit_id": 9,
      "text": "历史",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 10,
      "text": "* 1953年5月18日 二级国道123号千叶水户线（千叶县千叶市 - 茨城县水户市）",
      "type": "list-item",
      "level": 2,
      "parent_id": 9
    },
    {
      "unit_id": 11,
      "text": "* 1963年4月1日 一级国道51号（千叶县千叶市 - 茨城县水户市）  -- 123号升格。123号为宇都宫市 - 水户市区间。",
      "type": "list-item",
      "level": 2,
      "parent_id": 9
    },
    {
      "unit_id": 12,
      "text": "* 1965年4月1日 一般国道51号（千叶县千叶市 - 茨城县水户市）",
      "type": "list-item",
      "level": 2,
      "parent_id": 9
    },
    {
      "unit_id": 13,
      "text": "重复区间",
      "type": "heading",
      "level": 1,
      "parent_id": 0
    },
    {
      "unit_id": 14,
      "text": "* 茨城县水户市塩崎町（塩崎町交点） - 茨城县水户市三之丸（三之丸1丁目交点）：国道245号",
      "type": "list-item",
      "level": 2,
      "parent_id": 13
    },
    {
      "unit_id": 15,
      "text": "* 茨城县鹿嶋市宫中 - 茨城县水户市三之丸（三之丸1丁目交点）：国道124号",
      "type": "list-item",
      "level": 2,
      "parent_id": 13
    },
    {
      "unit_id": 16,
      "text": "* 千叶县香取市佐原（国道356号交点） - 茨城县潮来市永山（永山交差点）：国道355号",
      "type": "list-item",
      "level": 2,
      "parent_id": 13
    },
    {
      "unit_id": 17,
      "text": "* 千叶县香取市佐原（国道356号交点） - 茨城县稻敷市西代（北田交差点）：国道125号",
      "type": "list-item",
      "level": 2,
      "parent_id": 13
    },
    {

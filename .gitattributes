# Research source/result hashes are based on LF bytes; preserve them on checkout.
/docs/research/*.py text eol=lf
/docs/research/*.md text eol=lf
/docs/research/results/*.json -text whitespace=cr-at-eol
/docs/research/results/*.svg -text whitespace=cr-at-eol,-blank-at-eol
/tests/research/*.py text eol=lf
